{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eventmap",
	"compatibility_date": "2026-09-11",
	"main": "worker/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/*", "!/_astro/*", "!/fonts/*"]
	},
	"send_email": [
		{ "name": "EMAIL" }
	]
}
