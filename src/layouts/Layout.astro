---
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	breadcrumbs?: { name: string; path: string }[];
	jsonLd?: object | object[];
}
const {
	title = "Tech Events Map | Global startup & tech conferences",
	description = "An open source interactive map of tech, startup, AI, fintech and developer conferences around the world.",
	image = "/og-image.png",
	type = "website",
	breadcrumbs,
	jsonLd,
} = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).toString();
const extraLd = [
	...(breadcrumbs
		? [{
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				itemListElement: breadcrumbs.map((b, i) => ({ "@type": "ListItem", position: i + 1, name: b.name, item: abs(b.path) })),
			}]
		: []),
	...(jsonLd ? [jsonLd].flat().map((o) => ({ "@context": "https://schema.org", ...o })) : []),
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Tech Events Map" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: "Tech Events Map",
			url: Astro.site?.toString(),
			description: "An open source interactive map of tech, startup, AI and fintech conferences worldwide.",
		})} />

		{extraLd.map((o) => <script is:inline type="application/ld+json" set:html={JSON.stringify(o)} />)}

		<link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&display=swap" rel="stylesheet" />
		<script is:inline>
			(function () {
				var saved = null;
				try { saved = localStorage.getItem("em_theme"); } catch (e) {}
				var theme = saved || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.classList.toggle("dark", theme === "dark");
			})();
		</script>
		<link rel="stylesheet" href="/rt.css" />
		<script is:inline src="/rt.js"></script>
		<script is:inline src="/track.js" defer></script>
	</head>
	<body>
		<slot />
		<SiteFooter />
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--surface: #f7f7f7;
		--surface-2: #ececec;
		--border: #dddddd;
		--text: #000000;
		--text-dim: #666666;
		--accent: #e00000;
		--mega: #c04040;
		--major: #b8860b;
		--notable: #3a7a30;
		--font: "PT Sans", -apple-system, sans-serif;
	}
	html.dark {
		--bg: #0e0e0e;
		--surface: #161616;
		--surface-2: #222222;
		--border: #333333;
		--text: #f2f2f0;
		--text-dim: #9a9a9a;
		--accent: #ff2b2b;
		--mega: #ff6b6b;
		--major: #e8b84b;
		--notable: #7fb07f;
	}
	* { box-sizing: border-box; }
	html, body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
		font-size: 18px;
		line-height: 1.5;
	}
	body {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
	}
	a { color: inherit; }
	.wrap-wide {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 32px 24px 64px;
	}
	.wrap-narrow {
		width: 100%;
		max-width: 820px;
		margin: 0 auto;
		padding: 32px 24px 64px;
	}
	@media (max-width: 640px) {
		.wrap-wide, .wrap-narrow {
			padding: 20px 16px 48px;
		}
	}
	.crumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px;
		font-family: var(--font);
		font-size: 13px;
		color: var(--text-dim);
		margin-bottom: 10px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.crumbs a {
		color: var(--text-dim);
		text-decoration: none;
	}
	.crumbs a:hover {
		color: var(--accent);
	}
	.crumbs span {
		opacity: 0.5;
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		font-family: var(--font);
		font-size: 13px;
		color: var(--text-dim);
		user-select: none;
		white-space: nowrap;
	}
	.pill.active {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--bg);
	}
	.filter-tag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font);
		font-size: 14px;
		padding: 5px 11px;
		border-radius: 4px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-dim);
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s, background-color 0.15s;
		user-select: none;
		white-space: nowrap;
	}
	.filter-tag:hover {
		border-color: var(--text-dim);
		color: var(--text);
	}
	.filter-tag.active {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.filter-tag .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		font-family: var(--font);
		font-size: 13.5px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 8px 14px;
		border-radius: 5px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s, background-color 0.15s;
		white-space: nowrap;
	}
	.btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.btn-primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.btn-primary:hover {
		opacity: 0.9;
		color: var(--bg);
	}
	.card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 20px;
	}
	.tier-mega { color: var(--mega); }
	.tier-major { color: var(--major); }
	.tier-notable { color: var(--notable); }
</style>
