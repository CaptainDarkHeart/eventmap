---
interface Props {
	title?: string;
	description?: string;
}
const {
	title = "Tech Events Map | Global startup & tech conferences",
	description = "An interactive map of tech, startup, AI, fintech and developer conferences around the world.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=PT+Mono&display=swap" rel="stylesheet" />
		<script is:inline>
			(function () {
				var saved = localStorage.getItem("em_theme");
				var theme = saved || "light";
				document.documentElement.classList.toggle("dark", theme === "dark");
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--surface: #f7f7f7;
		--surface-2: #ececec;
		--border: #dddddd;
		--text: #000000;
		--text-dim: #666666;
		--accent: #e00000;
		--mega: #c04040;
		--major: #b8860b;
		--notable: #3a7a30;
		--font: "PT Sans", -apple-system, sans-serif;
		--mono: "PT Mono", monospace;
	}
	html.dark {
		--bg: #0e0e0e;
		--surface: #161616;
		--surface-2: #222222;
		--border: #333333;
		--text: #f2f2f0;
		--text-dim: #9a9a9a;
		--accent: #ff2b2b;
		--mega: #ff6b6b;
		--major: #e8b84b;
		--notable: #7fb07f;
	}
	* { box-sizing: border-box; }
	html, body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
		font-size: 20px;
	}
	a { color: inherit; }
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 11px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: transparent;
		font-family: var(--mono);
		font-size: 15px;
		cursor: pointer;
		color: var(--text-dim);
		user-select: none;
		white-space: nowrap;
	}
	.pill.active {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--bg);
	}
	.tier-mega { color: var(--mega); }
	.tier-major { color: var(--major); }
	.tier-notable { color: var(--notable); }
</style>
