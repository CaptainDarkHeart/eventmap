---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
}
const {
	title = "Tech Events Map | Global startup & tech conferences",
	description = "An open source interactive map of tech, startup, AI, fintech and developer conferences around the world.",
	image = "/og-image.png",
	type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Tech Events Map" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: "Tech Events Map",
			url: Astro.site?.toString(),
			description: "An open source interactive map of tech, startup, AI and fintech conferences worldwide.",
		})} />

		<link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=PT+Mono&display=swap" rel="stylesheet" />
		<script is:inline>
			(function () {
				var saved = null;
				try { saved = localStorage.getItem("em_theme"); } catch (e) {}
				var theme = saved || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.classList.toggle("dark", theme === "dark");
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--surface: #f7f7f7;
		--surface-2: #ececec;
		--border: #dddddd;
		--text: #000000;
		--text-dim: #666666;
		--accent: #e00000;
		--mega: #c04040;
		--major: #b8860b;
		--notable: #3a7a30;
		--font: "PT Sans", -apple-system, sans-serif;
		--mono: "PT Mono", monospace;
	}
	html.dark {
		--bg: #0e0e0e;
		--surface: #161616;
		--surface-2: #222222;
		--border: #333333;
		--text: #f2f2f0;
		--text-dim: #9a9a9a;
		--accent: #ff2b2b;
		--mega: #ff6b6b;
		--major: #e8b84b;
		--notable: #7fb07f;
	}
	* { box-sizing: border-box; }
	html, body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
		font-size: 20px;
	}
	a { color: inherit; }
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 11px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: transparent;
		font-family: var(--mono);
		font-size: 15px;
		cursor: pointer;
		color: var(--text-dim);
		user-select: none;
		white-space: nowrap;
	}
	.pill.active {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--bg);
	}
	.tier-mega { color: var(--mega); }
	.tier-major { color: var(--major); }
	.tier-notable { color: var(--notable); }
</style>
