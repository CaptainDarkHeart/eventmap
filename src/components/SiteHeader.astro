---
---
<header>
	<a class="logo" href="/">
		<h1>Tech Events</h1>
		<span>Map</span>
	</a>
	<nav id="site-nav">
		<a href="/">Map</a>
		<a href="/events">All Events</a>
		<a href="/submit">Submit Event</a>
		<a href="/about">About</a>
		<a href="/contact">Contact</a>
		<a class="github-link" href="https://github.com/CaptainDarkHeart/eventmap" target="_blank" rel="noopener" aria-label="GitHub">
			<svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
			<span class="github-text">GitHub</span>
		</a>
	</nav>
	<div class="header-right">
		<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle light or dark theme" title="Toggle theme">&#9788;</button>
		<button id="nav-toggle" class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">&#9776;</button>
	</div>
</header>

<script>
	// Same key the map page writes, so the choice carries across every page
	const themeToggle = document.getElementById("theme-toggle");
	themeToggle?.addEventListener("click", () => {
		const dark = !document.documentElement.classList.contains("dark");
		document.documentElement.classList.toggle("dark", dark);
		try {
			localStorage.setItem("em_theme", dark ? "dark" : "light");
		} catch {
			// private mode or blocked storage: the toggle still works for this page
		}
	});

	const toggle = document.getElementById("nav-toggle");
	const nav = document.getElementById("site-nav");
	toggle?.addEventListener("click", () => {
		const open = nav?.classList.toggle("open");
		toggle.setAttribute("aria-expanded", open ? "true" : "false");
	});
</script>

<style>
	header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		padding: 12px 20px;
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}
	.logo {
		display: flex;
		align-items: baseline;
		gap: 8px;
		text-decoration: none;
		color: inherit;
	}
	.logo h1 {
		font-size: 22.5px;
		font-weight: 700;
		letter-spacing: 0.01em;
		text-transform: uppercase;
	}
	.logo span {
		font-family: var(--font);
		font-size: 14px;
		color: var(--text-dim);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 20px;
		justify-content: center;
	}
	nav a {
		font-family: var(--font);
		font-size: 15.5px;
		color: var(--text-dim);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	nav a:hover { color: var(--text); }
	.github-link {
		display: none;
	}
	.github-link svg {
		display: block;
		width: 19px;
		height: 19px;
		flex-shrink: 0;
	}
	.header-right { display: flex; align-items: center; gap: 12px; justify-content: flex-end; }
	.theme-toggle {
		background: none;
		border: 1px solid var(--border);
		color: var(--text-dim);
		font-size: 17.5px;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.theme-toggle:hover { border-color: var(--text-dim); color: var(--text); }
	.nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: none;
		border: 1px solid var(--border);
		border-radius: 6px;
		color: var(--text);
		font-family: var(--font);
		font-size: 19px;
		line-height: 1;
		cursor: pointer;
		padding: 0;
	}
	@media (max-width: 900px) {
		header { grid-template-columns: minmax(0, 1fr) auto; }
		nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
			z-index: 10;
		}
		nav.open { display: flex; }
		nav a { width: 100%; padding: 14px 20px; border-top: 1px solid var(--border); }
		nav a:first-child { border-top: none; }
		.github-link { display: inline-flex; align-items: center; gap: 8px; }
		.github-text { display: inline; }
		header { position: relative; }
		.nav-toggle { display: inline-block; }
	}
</style>
