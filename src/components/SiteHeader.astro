---
interface Props {
	fixed?: boolean;
}
const { fixed = false } = Astro.props;
const p = Astro.url.pathname;
const isMap = p === "/";
const isEvents = p.startsWith("/events");
const isBrowse = p.startsWith("/countries") || p.startsWith("/cities") || p.startsWith("/topics") || p.startsWith("/regions");
const isPlan = p.startsWith("/plan");
const isSubmit = p.startsWith("/submit");
const isAbout = p.startsWith("/about");
const isContact = p.startsWith("/contact");
---
<header class:list={[{ "is-fixed": fixed }]}>
	<a class="logo" href="/">
		{isMap ? <h1 class="logo-name">Tech Events</h1> : <strong class="logo-name">Tech Events</strong>}
		<span>Map</span>
	</a>
	<nav id="site-nav" aria-label="Main navigation">
		<a href="/" aria-current={isMap ? "page" : undefined}>Map</a>
		<a href="/events/" aria-current={isEvents ? "page" : undefined}>All Events</a>
		<a href="/countries/" aria-current={isBrowse ? "page" : undefined}>Browse</a>
		<a href="/plan/" aria-current={isPlan ? "page" : undefined}>Plan</a>
		<a href="/about/" aria-current={isAbout ? "page" : undefined}>About</a>
		<a href="/contact/" aria-current={isContact ? "page" : undefined}>Contact</a>
		<a class="nav-submit-mobile" href="/submit/" aria-current={isSubmit ? "page" : undefined}>+ Submit Event</a>
	</nav>
	<div class="header-right">
		<a class:list={["header-cta", { active: isSubmit }]} href="/submit/" aria-current={isSubmit ? "page" : undefined}>+ Submit Event</a>
		<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle light or dark theme" title="Toggle theme">&#9788;</button>
		<button id="nav-toggle" class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">&#9776;</button>
	</div>
</header>

<script>
	// Same key the map page writes, so the choice carries across every page
	const themeToggle = document.getElementById("theme-toggle");
	themeToggle?.addEventListener("click", () => {
		if ((window as any).RT && (window as any).RT.active()) return;
		const dark = !document.documentElement.classList.contains("dark");
		document.documentElement.classList.toggle("dark", dark);
		try {
			localStorage.setItem("em_theme", dark ? "dark" : "light");
		} catch {
			// private mode or blocked storage: the toggle still works for this page
		}
		window.dispatchEvent(new CustomEvent("em-theme-change", { detail: { dark } }));
	});

	const toggle = document.getElementById("nav-toggle");
	const nav = document.getElementById("site-nav");
	toggle?.addEventListener("click", () => {
		const open = nav?.classList.toggle("open");
		toggle.setAttribute("aria-expanded", open ? "true" : "false");
	});
</script>

<style>
	header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		padding: 0 24px;
		height: 56px;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		position: sticky;
		top: 0;
		z-index: 1000;
	}
	header.is-fixed {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
	}
	.logo {
		display: inline-flex;
		align-items: baseline;
		gap: 7px;
		text-decoration: none;
		color: inherit;
		justify-self: start;
	}
	.logo .logo-name {
		margin: 0;
		font-size: 20px;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	.logo span {
		font-family: var(--font);
		font-size: 12.5px;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 700;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 4px;
		justify-content: center;
		height: 100%;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		height: 100%;
		padding: 0 12px;
		font-family: var(--font);
		font-size: 14px;
		font-weight: 700;
		color: var(--text-dim);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		border-bottom: 2px solid transparent;
		transition: color 0.15s, border-color 0.15s;
	}
	nav a:hover {
		color: var(--text);
	}
	nav a[aria-current="page"] {
		color: var(--text);
		border-bottom-color: var(--accent);
	}
	.nav-submit-mobile {
		display: none;
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 10px;
		justify-content: flex-end;
	}
	.header-cta {
		font-family: var(--font);
		font-size: 12.5px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 5px 11px;
		border-radius: 4px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
		transition: border-color 0.15s, color 0.15s, background-color 0.15s;
	}
	.header-cta:hover,
	.header-cta.active {
		border-color: var(--accent);
		color: var(--accent);
	}
	.theme-toggle {
		background: none;
		border: 1px solid var(--border);
		color: var(--text-dim);
		font-size: 16px;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: border-color 0.15s, color 0.15s;
	}
	.theme-toggle:hover {
		border-color: var(--text-dim);
		color: var(--text);
	}
	.nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: none;
		border: 1px solid var(--border);
		border-radius: 6px;
		color: var(--text);
		font-family: var(--font);
		font-size: 18px;
		line-height: 1;
		cursor: pointer;
		padding: 0;
	}
	@media (max-width: 960px) {
		header {
			grid-template-columns: minmax(0, 1fr) auto;
			padding: 0 16px;
		}
		nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			height: auto;
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
			z-index: 1001;
			box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
		}
		nav.open {
			display: flex;
		}
		nav a {
			width: 100%;
			height: auto;
			padding: 13px 20px;
			border-top: 1px solid var(--border);
			border-bottom: none;
		}
		nav a[aria-current="page"] {
			color: var(--accent);
			background: var(--surface);
		}
		nav a:first-child {
			border-top: none;
		}
		.nav-submit-mobile {
			display: inline-flex;
			color: var(--accent);
		}
		.header-cta {
			display: none;
		}
		.nav-toggle {
			display: inline-flex;
		}
	}
</style>
