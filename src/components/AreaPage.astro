---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import BrowseNav from "./BrowseNav.astro";
import { TYPES, slugify, fmtInt, fmtDate, list, groupsFor, canonCountry } from "../lib/areas.mjs";
import { TIERS, TOPICS } from "../lib/topics";
const { group: g } = Astro.props;
const t = TYPES[g.type];
const place = g.type === "cities" ? `${g.name}, ${g.cityCountry}` : g.name;
const scope = t.scope(g.name);
const h1 = t.title(g.name);

// Cross-links only to pages that exist.
const exists = {
	countries: new Set(groupsFor("countries").map((x) => x.slug)),
	cities: new Set(groupsFor("cities").map((x) => x.slug)),
	topics: new Set(groupsFor("topics").map((x) => x.slug)),
};
const link = (type, name) => (exists[type].has(slugify(name)) ? `/${type}/${slugify(name)}/` : null);

const today = new Date().toISOString().slice(0, 10);
const next = g.events.find((e) => e.end >= today) ?? g.events[0];
const soon = g.events.filter((e) => e.start <= new Date(Date.now() + 30 * 86400000).toISOString().slice(0, 10)).length;
const three = g.events.slice(0, 3);
const big = g.biggest;
const otherTop = g.type === "countries" || g.type === "cities" ? { label: "topics", rows: g.topics } : g.type === "topics" ? { label: "countries", rows: g.countries } : { label: "countries", rows: g.countries };

const faqs = [
	{
		q: `What tech conferences are happening ${scope}?`,
		a: `${fmtInt(g.count)} upcoming tech, startup, AI and fintech events are listed ${scope}. The next ones are ${list(three.map((e) => `${e.name} (${fmtDate(e.start, e.end)}${g.type !== "cities" ? `, ${e.city}` : ""})`))}.`,
	},
	{
		q: `What is the biggest tech event ${scope}?`,
		a: `${big.name}, ${fmtDate(big.start, big.end)} in ${big.city}, ${canonCountry(big.country)}. It is listed as a ${TIERS[big.tier]} event.`,
	},
	{
		q: `When is the next tech event ${scope}?`,
		a: `${next.name} runs ${fmtDate(next.start, next.end)} in ${next.city}. ${soon > 0 ? `${fmtInt(soon)} event${soon === 1 ? " starts" : "s start"} in the next 30 days.` : "Nothing else starts in the next 30 days."}`,
	},
];
if (otherTop.rows.length >= 3) {
	faqs.push({
		q: g.type === "topics" ? `Which countries host the most ${g.name} events?` : `Which topics do events ${scope} cover?`,
		a: `${list(otherTop.rows.slice(0, 4).map(([n, c]) => `${n} (${fmtInt(c)})`))}, by number of upcoming events.`,
	});
}
faqs.push({
	q: "Where does this data come from?",
	a: "Event dates come from public listings including Dealroom, Techmeme, dev.events and others, plus individually verified additions. Dates can shift year to year, so always confirm on the official event site before booking travel.",
});

const title = `${h1}: ${fmtInt(g.count)} upcoming | Tech Events Map`;
const description = `${fmtInt(g.count)} upcoming tech, startup, AI and fintech conferences ${scope}. Next up: ${next.name}, ${fmtDate(next.start, next.end)}. Dates, cities and topics.`;
const path = `/${g.type}/${g.slug}/`;
---
<Layout title={title} description={description}
	breadcrumbs={[{ name: "Home", path: "/" }, { name: t.label, path: `/${g.type}/` }, { name: place, path }]}
	jsonLd={[
		{ "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
		{ "@type": "CollectionPage", name: h1, description, url: new URL(path, Astro.site).toString(),
			mainEntity: { "@type": "ItemList", itemListElement: g.events.slice(0, 50).map((e, i) => ({ "@type": "ListItem", position: i + 1, url: new URL(`/events/${e.slug}/`, Astro.site).toString(), name: e.name })) } },
	]}>
	<SiteHeader />
	<main class="wrap-wide">
		<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={`/${g.type}/`}>{t.label}</a><span>/</span>{place}</nav>
		<div class="area-hero">
			<div>
				<h1>{h1}</h1>
				<p class="lead">{fmtInt(g.count)} upcoming tech, startup, AI and fintech conferences {scope}. The next is <a href={`/events/${next.slug}/`}>{next.name}</a> on {fmtDate(next.start, next.end)}{g.type !== "cities" ? ` in ${next.city}` : ""}. The biggest is <a href={`/events/${big.slug}/`}>{big.name}</a>.</p>
			</div>
			<div class="hero-actions">
				<a class="btn btn-primary" href={`/?area=${encodeURIComponent(`${g.type}:${g.key}`)}`}>Explore on Map &rarr;</a>
				<a class="btn" href="/events/">All Events</a>
			</div>
		</div>

		<div class="tallies">
			<div class="tally card">
				<span class="num-big">{fmtInt(g.count)}</span>
				<span class="tally-label">Upcoming Events</span>
			</div>
			<div class="tally card">
				<span class="num-big">{fmtInt(soon)}</span>
				<span class="tally-label">Next 30 Days</span>
			</div>
			{g.tiers.mega + g.tiers.major > 0 && (
				<div class="tally card">
					<span class="num-big">{fmtInt(g.tiers.mega + g.tiers.major)}</span>
					<span class="tally-label">Major or Mega</span>
				</div>
			)}
		</div>

		<div class="facets-row">
			{g.type !== "cities" && g.cities.length > 1 && (
				<div class="facet-box card">
					<h2>Top cities</h2>
					<div class="chips">{g.cities.map(([n, c]) => {
						const ck = g.events.find((e) => e.city === n);
						const h = ck ? link("cities", n) : null;
						return h ? <a href={h}>{n}<small>{fmtInt(c)}</small></a> : <span class="chip-plain">{n} ({fmtInt(c)})</span>;
					})}</div>
				</div>
			)}

			{otherTop.rows.length > 0 && (
				<div class="facet-box card">
					<h2>{g.type === "topics" ? "Top countries" : "Topics"}</h2>
					<div class="chips">{otherTop.rows.map(([n, c]) => {
						const h = g.type === "topics" ? link("countries", n) : link("topics", n);
						return h ? <a href={h}>{n}<small>{fmtInt(c)}</small></a> : <span class="chip-plain">{n} ({fmtInt(c)})</span>;
					})}</div>
				</div>
			)}
		</div>

		<h2 class="sec-title">Upcoming events ({fmtInt(g.count)})</h2>
		<div class="tbl-wrap">
			<table>
				<thead>
					<tr>
						<th scope="col">Event</th>
						<th scope="col">Dates</th>
						<th scope="col">{g.type === "cities" ? "Topics" : "Location"}</th>
						<th scope="col">Size</th>
					</tr>
				</thead>
				<tbody>
					{g.events.map((e) => (
						<tr>
							<td class="ev-col"><a href={`/events/${e.slug}/`}>{e.name}</a></td>
							<td class="num">{fmtDate(e.start, e.end)}</td>
							<td>{g.type === "cities" ? e.topics.map((k) => TOPICS[k]?.label ?? k).join(", ") : `${e.city}, ${canonCountry(e.country)}`}</td>
							<td class={`tier-${e.tier} tier-col`}>{TIERS[e.tier]}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<h2 class="sec-title">Frequently asked questions</h2>
		<div class="faq-grid">
			{faqs.map((f) => (
				<div class="faq-item card">
					<h3>{f.q}</h3>
					<p>{f.a}</p>
				</div>
			))}
		</div>

		<h2 class="sec-title">Browse more</h2>
		<BrowseNav current={g.type} />
	</main>
</Layout>
<style>
	.area-hero {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 24px;
		flex-wrap: wrap;
		margin-bottom: 22px;
	}
	h1 {
		margin: 0 0 8px;
		font-size: 34px;
		font-weight: 700;
		line-height: 1.15;
	}
	.lead {
		margin: 0;
		font-size: 17px;
		line-height: 1.55;
		color: var(--text-dim);
		max-width: 700px;
	}
	.lead a {
		color: var(--accent);
		text-decoration: none;
		font-weight: 700;
	}
	.lead a:hover {
		text-decoration: underline;
	}
	.hero-actions {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}
	.tallies {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 12px;
		margin-bottom: 20px;
	}
	.tally {
		display: flex;
		flex-direction: column;
		padding: 16px 20px;
	}
	.num-big {
		font-size: 34px;
		font-weight: 700;
		line-height: 1;
		color: var(--accent);
		font-family: var(--font);
		font-variant-numeric: tabular-nums;
	}
	.tally-label {
		font-family: var(--font);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-dim);
		margin-top: 6px;
	}
	.facets-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 14px;
		margin-bottom: 28px;
	}
	.facet-box {
		padding: 16px 18px;
	}
	.facet-box h2 {
		margin: 0 0 10px;
		font-family: var(--font);
		font-size: 12.5px;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--text-dim);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}
	.chips a {
		font-size: 14px;
		text-decoration: none;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text);
		padding: 4px 11px;
		border-radius: 999px;
		transition: border-color 0.15s, color 0.15s;
	}
	.chips a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.chips small {
		font-family: var(--font);
		color: var(--text-dim);
		font-size: 12px;
		margin-left: 5px;
	}
	.chip-plain {
		font-size: 14px;
		color: var(--text-dim);
		border: 1px solid var(--border);
		padding: 4px 11px;
		border-radius: 999px;
	}
	.sec-title {
		margin: 32px 0 12px;
		font-size: 21px;
		font-weight: 700;
	}
	.tbl-wrap {
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 16px;
	}
	th, td {
		text-align: left;
		padding: 11px 14px;
		border-bottom: 1px solid var(--border);
		vertical-align: middle;
	}
	tbody tr:last-child td {
		border-bottom: none;
	}
	tbody tr:hover {
		background: var(--surface);
	}
	th {
		color: var(--text-dim);
		background: var(--surface);
		font-weight: 700;
		font-size: 12.5px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-family: var(--font);
	}
	td.ev-col a {
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}
	td.ev-col a:hover {
		color: var(--accent);
	}
	td.num {
		font-family: var(--font);
		white-space: nowrap;
		font-size: 14px;
		color: var(--text-dim);
	}
	td.tier-col {
		font-family: var(--font);
		font-size: 13px;
		font-weight: 700;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.faq-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 12px;
	}
	.faq-item {
		padding: 16px 18px;
	}
	.faq-item h3 {
		font-size: 16.5px;
		margin: 0 0 6px;
	}
	.faq-item p {
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--text-dim);
		margin: 0;
	}
</style>
