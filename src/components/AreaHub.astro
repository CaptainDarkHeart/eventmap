---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import BrowseNav from "./BrowseNav.astro";
import { TYPES, groupsFor, fmtInt, fmtDate } from "../lib/areas.mjs";
const { type } = Astro.props;
const t = TYPES[type];
const groups = groupsFor(type);
const noun = type === "topics" ? "topic" : t.single;
const title = `Tech events by ${t.single} | Tech Events Map`;
const description = `Browse upcoming tech, startup, AI and fintech conferences by ${t.single}: ${groups.length} ${t.label.toLowerCase()} with event counts and the next dates.`;
const today = new Date().toISOString().slice(0, 10);
---
<Layout title={title} description={description}
	breadcrumbs={[{ name: "Home", path: "/" }, { name: t.label, path: `/${type}/` }]}
	jsonLd={{ "@type": "CollectionPage", name: `Tech events by ${t.single}`, description, url: new URL(`/${type}/`, Astro.site).toString(),
		mainEntity: { "@type": "ItemList", itemListElement: groups.map((g, i) => ({ "@type": "ListItem", position: i + 1, url: new URL(`/${type}/${g.slug}/`, Astro.site).toString(), name: g.name })) } }}>
	<SiteHeader />
	<main class="wrap-wide">
		<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>{t.label}</nav>
		<div class="hub-head">
			<div>
				<h1>Tech events by {t.single}</h1>
				<p class="sub">{groups.length} {t.label.toLowerCase()}{t.min > 1 ? ` with at least ${t.min} upcoming events` : ""}. Pick a {noun} to see the next conferences, the biggest events and the dates.</p>
			</div>
			{groups.length > 8 && (
				<div class="hub-filter-wrap">
					<input id="hub-filter" class="hub-filter" type="text" placeholder={`Filter ${t.label.toLowerCase()}...`} autocomplete="off" />
				</div>
			)}
		</div>

		<BrowseNav current={type} />

		<div class="hub-grid" id="hub-grid">
			{groups.map((g) => {
				const next = g.events.find((e) => e.end >= today) ?? g.events[0];
				const label = `${g.name}${g.cityCountry ? `, ${g.cityCountry}` : ""}`;
				return (
					<a class="hub-card card" href={`/${type}/${g.slug}/`} data-name={label.toLowerCase()}>
						<div class="hub-card-top">
							<span class="hub-name">{label}</span>
							<span class="hub-count">{fmtInt(g.count)}</span>
						</div>
						{next && (
							<div class="hub-next">
								<span class="hub-next-label">Next:</span> {next.name}
								<span class="hub-next-date">{fmtDate(next.start, next.end)}</span>
							</div>
						)}
					</a>
				);
			})}
		</div>
		<p id="hub-empty" class="empty" hidden>No matching {t.label.toLowerCase()}.</p>
		<p class="note">Events are listed until they end. See the <a href="/about/">about page</a> for sources.</p>
	</main>
</Layout>

<script>
	const input = document.getElementById("hub-filter") as HTMLInputElement | null;
	const cards = Array.from(document.querySelectorAll<HTMLElement>("#hub-grid .hub-card"));
	const empty = document.getElementById("hub-empty");
	input?.addEventListener("input", () => {
		const q = input.value.trim().toLowerCase();
		let shown = 0;
		for (const c of cards) {
			const ok = !q || (c.dataset.name ?? "").includes(q);
			c.hidden = !ok;
			if (ok) shown++;
		}
		if (empty) empty.hidden = shown > 0;
	});
</script>

<style>
	.hub-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 20px;
		flex-wrap: wrap;
	}
	h1 {
		margin: 0 0 6px;
		font-size: 32px;
		font-weight: 700;
		line-height: 1.15;
	}
	.sub {
		margin: 0;
		color: var(--text-dim);
		font-size: 16.5px;
		max-width: 680px;
	}
	.hub-filter-wrap {
		flex: 0 1 260px;
		min-width: 220px;
	}
	.hub-filter {
		width: 100%;
		background: var(--surface);
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font);
		font-size: 15px;
		padding: 8px 12px;
		border-radius: 5px;
		outline: none;
	}
	.hub-filter:focus {
		border-color: var(--accent);
	}
	.hub-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
		gap: 12px;
		margin: 4px 0 24px;
	}
	.hub-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 8px;
		padding: 14px 16px;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.15s, transform 0.15s;
	}
	.hub-card:hover {
		border-color: var(--accent);
	}
	.hub-card-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}
	.hub-name {
		font-size: 17.5px;
		font-weight: 700;
		line-height: 1.25;
	}
	.hub-card:hover .hub-name {
		color: var(--accent);
	}
	.hub-count {
		font-family: var(--font);
		font-size: 13px;
		font-weight: 700;
		color: var(--accent);
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 2px 8px;
		border-radius: 999px;
		white-space: nowrap;
	}
	.hub-next {
		font-size: 13.5px;
		color: var(--text-dim);
		line-height: 1.4;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.hub-next-label {
		font-family: var(--font);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.hub-next-date {
		font-family: var(--font);
		font-size: 12px;
		color: var(--text-dim);
	}
	.empty {
		font-family: var(--font);
		color: var(--text-dim);
		padding: 20px 0;
	}
	.note {
		color: var(--text-dim);
		font-size: 14.5px;
		margin: 0;
	}
	.note a {
		color: var(--accent);
	}
</style>
