---
import { TYPES, groupsFor } from "../lib/areas.mjs";
const { current } = Astro.props;
---
<nav class="browse-tabs" aria-label="Browse categories">
	{Object.entries(TYPES).map(([k, t]) => {
		const count = groupsFor(k).length;
		return (
			<a href={`/${k}/`} aria-current={k === current ? "page" : undefined}>
				<span>By {t.single}</span>
				<small>{count}</small>
			</a>
		);
	})}
</nav>
<style>
	.browse-tabs {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 4px;
		padding: 4px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		margin: 12px 0 22px;
	}
	.browse-tabs a {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-family: var(--font);
		font-size: 14.5px;
		font-weight: 700;
		text-decoration: none;
		color: var(--text-dim);
		padding: 6px 14px;
		border-radius: 4px;
		border: 1px solid transparent;
		transition: color 0.15s, background-color 0.15s, border-color 0.15s;
	}
	.browse-tabs a:hover {
		color: var(--text);
	}
	.browse-tabs a[aria-current="page"] {
		background: var(--bg);
		color: var(--text);
		border-color: var(--border);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
	}
	.browse-tabs small {
		font-family: var(--font);
		font-size: 11.5px;
		font-weight: 400;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		padding: 1px 6px;
		border-radius: 999px;
	}
</style>
