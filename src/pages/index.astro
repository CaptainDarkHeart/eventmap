---
import events from "../data/events.json";

const cartoKey = import.meta.env.PUBLIC_CARTO_KEY;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Tech Events Map | Global startup &amp; tech conferences</title>
<meta name="description" content="An open source interactive map of tech, startup, AI, fintech and developer conferences around the world.">
<link rel="canonical" href="https://techeventsmap.com/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Tech Events Map">
<meta property="og:title" content="Tech Events Map | Global startup &amp; tech conferences">
<meta property="og:description" content="An open source interactive map of tech, startup, AI, fintech and developer conferences around the world.">
<meta property="og:url" content="https://techeventsmap.com/">
<meta property="og:image" content="https://techeventsmap.com/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Tech Events Map | Global startup &amp; tech conferences">
<meta name="twitter:description" content="An open source interactive map of tech, startup, AI, fintech and developer conferences around the world.">
<meta name="twitter:image" content="https://techeventsmap.com/og-image.png">
<script is:inline type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Tech Events Map",
	url: "https://techeventsmap.com/",
	description: "An open source interactive map of tech, startup, AI and fintech conferences worldwide.",
})} />
<link rel="icon" href="/favicon.svg">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=PT+Mono&display=swap" rel="stylesheet">
<style is:global>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#ffffff;--surface:#f7f7f7;--surface-2:#ececec;--border:#dddddd;--text:#000000;--text-dim:#666666;--accent:#e00000;--mega:#c04040;--major:#b8860b;--notable:#3a7a30;--font:'PT Sans',-apple-system,sans-serif;--mono:'PT Mono',monospace}
html.dark{--bg:#0e0e0e;--surface:#161616;--surface-2:#222222;--border:#333333;--text:#f2f2f0;--text-dim:#9a9a9a;--accent:#ff2b2b;--mega:#ff6b6b;--major:#e8b84b;--notable:#7fb07f}
html{height:100%;overflow:hidden;overscroll-behavior:none}
body{font-family:var(--font);background:var(--bg);color:var(--text);height:100dvh;overflow:hidden;overscroll-behavior:none;position:relative}
header{position:fixed;top:0;left:0;right:0;display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;padding:12px 20px;border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:1000}
.header-right{position:absolute;top:50%;right:20px;transform:translateY(-50%)}
.logo{display:flex;align-items:baseline;gap:8px;text-decoration:none;color:inherit}
.logo h1{font-size:22.5px;font-weight:700;letter-spacing:0.01em;text-transform:uppercase}
.logo span{font-family:var(--font);font-size:14px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.08em}
nav{display:flex;align-items:center;gap:20px;justify-content:center}
nav a{font-family:var(--font);font-size:15.5px;color:var(--text-dim);text-decoration:none;text-transform:uppercase;letter-spacing:0.06em;transition:color 0.15s}
nav a:hover{color:var(--text)}
.github-link{display:none}
.github-link svg{display:block;width:19px;height:19px;flex-shrink:0}
.header-right{display:flex;align-items:center;gap:12px;justify-content:flex-end}
.theme-toggle{background:none;border:1px solid var(--border);color:var(--text-dim);font-size:17.5px;width:28px;height:28px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s;flex-shrink:0}
.theme-toggle:hover{border-color:var(--text-dim);color:var(--text)}
.nav-toggle{display:none;align-items:center;justify-content:center;width:30px;height:30px;background:none;border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:var(--font);font-size:19px;line-height:1;cursor:pointer;padding:0;flex-shrink:0}
.main{position:fixed;inset:0;display:flex;overflow:hidden}
.sidebar{width:320px;flex-shrink:0;display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--bg);overflow:hidden;padding-top:54px}
.filters{padding:12px;border-bottom:1px solid var(--border)}
.filters-header{font-size:16px;font-weight:700;letter-spacing:-0.01em;color:var(--text);margin-bottom:10px}
.filter-group{margin-bottom:10px}.filter-group:last-child{margin-bottom:0}
.filter-group h3{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-dim);margin-bottom:7px}
.filter-tags{display:flex;flex-wrap:wrap;gap:5px}
.filter-tag{font-family:var(--font);font-size:14px;padding:4px 9px;border-radius:3px;border:1px solid var(--border);background:transparent;color:var(--text-dim);cursor:pointer;transition:all 0.15s;user-select:none;display:inline-flex;align-items:center;gap:5px}
.filter-tag:hover{border-color:var(--text-dim);color:var(--text)}
.filter-tag.active{background:var(--accent);border-color:var(--accent);color:var(--bg)}
.filter-tag .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.search-wrap{position:relative;margin-bottom:10px}
.search-input{width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);font-family:var(--font);font-size:16px;padding:7px 30px 7px 9px;border-radius:4px;outline:none}
.search-input::placeholder{color:var(--text-dim)}
.search-input:focus{border-color:var(--accent)}
.event-list{flex:1;overflow-y:auto;padding:6px}
.event-list::-webkit-scrollbar{width:4px}
.event-list::-webkit-scrollbar-track{background:transparent}
.event-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
.event-card{padding:10px;border-radius:5px;cursor:pointer;transition:background-color 0.15s,border-color 0.15s;border:1px solid transparent;margin-bottom:3px}
.event-card:hover{background:var(--surface);border-color:var(--border)}
.event-card.selected{background:var(--surface);border-color:var(--accent)}
.event-card .name{font-size:17.5px;font-weight:700;margin-bottom:3px;display:flex;align-items:center;gap:6px}
.event-card .name .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.event-card .meta{font-family:var(--font);font-size:14px;color:var(--text-dim);margin-bottom:5px}
.event-card .tags{display:flex;flex-wrap:wrap;gap:3px}
.event-card .card-links{margin-top:5px;font-size:13.5px}
.event-card .card-links a{position:relative;z-index:1;color:var(--accent)}
.mini-tag{font-family:var(--mono);font-size:12.5px;padding:2px 6px;border-radius:2px;background:var(--surface-2);color:var(--text-dim);text-transform:uppercase;letter-spacing:0.04em}
.mini-tag.mega{color:var(--mega)}
.mini-tag.major{color:var(--major)}
.mini-tag.notable{color:var(--notable)}
.empty-state{padding:24px 14px;color:var(--text-dim);font-size:16px;text-align:center}
.sidebar-footer{padding:10px 14px;border-top:1px solid var(--border);display:flex;align-items:center;background:var(--bg);flex-shrink:0}
.sidebar-footer a{display:inline-flex;align-items:center;color:var(--text-dim);transition:color 0.15s;text-decoration:none}
.sidebar-footer a:hover{color:var(--text)}
.sidebar-footer svg{width:20px;height:20px;display:block}
.map-container{flex:1;position:relative}
#map{width:100%;height:100%}
.leaflet-container{background:var(--surface)}
.leaflet-top{margin-top:66px}
.leaflet-control-zoom{border:1px solid var(--border)!important}
.leaflet-control-zoom a{background:var(--surface)!important;color:var(--text)!important;border-color:var(--border)!important}
.leaflet-control-zoom a:hover{background:var(--surface-2)!important}
.leaflet-control-attribution{background:rgba(255,255,255,0.8)!important;color:var(--text-dim)!important;font-size:11px!important}
html.dark .leaflet-control-attribution{background:rgba(14,14,14,0.8)!important}
.leaflet-control-attribution a{color:var(--text-dim)!important}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:var(--surface);color:var(--text)}
.leaflet-popup-content{font-family:var(--font);font-size:16px}
.leaflet-popup-content a{color:var(--accent)}
.popup-links{margin-top:6px;font-size:14px}
.list-link{position:absolute;bottom:16px;right:16px;z-index:800;background:var(--surface);border:1px solid var(--border);padding:8px 14px;border-radius:8px;font-size:16px;text-decoration:none;color:var(--text);box-shadow:0 4px 16px rgba(0,0,0,0.12)}
@media(max-width:900px){
  header{padding:10px 16px}
  nav{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:flex-start;gap:0;background:var(--bg);border-bottom:1px solid var(--border);z-index:1001}
  nav.open{display:flex}
  nav a{width:100%;padding:14px 20px;border-top:1px solid var(--border)}
  nav a:first-child{border-top:none}
  .github-link{display:inline-flex;align-items:center;gap:8px}
  .github-text{display:inline}
  .sidebar{display:none}
  .leaflet-control-zoom{display:none!important}
  .nav-toggle{display:inline-block}
}
</style>
</head>
<body>
<header>
  <a class="logo" href="/">
    <h1>Tech Events</h1>
    <span>Map</span>
  </a>
  <nav id="site-nav">
    <a href="/">Map</a>
    <a href="/events">All Events</a>
    <a href="/submit">Submit Event</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a class="github-link" href="https://github.com/CaptainDarkHeart/eventmap" target="_blank" rel="noopener" aria-label="GitHub">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
      <span class="github-text">GitHub</span>
    </a>
  </nav>
  <div class="header-right">
    <button id="theme-toggle" class="theme-toggle" type="button" title="Toggle theme">&#9788;</button>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">&#9776;</button>
  </div>
</header>

<div class="main">
  <aside class="sidebar">
    <div class="filters">
      <div class="filters-header">Filter</div>
      <div class="search-wrap">
        <input id="search" class="search-input" type="text" placeholder="Search events, cities..." autocomplete="off">
      </div>
      <div class="filter-group">
        <h3>Topic</h3>
        <div class="filter-tags" id="topic-tags">
          <button class="filter-tag active" data-topic="all">All</button>
        </div>
      </div>
      <div class="filter-group">
        <h3>Size</h3>
        <div class="filter-tags" id="tier-tags">
          <button class="filter-tag active" data-tier="all">All</button>
          <button class="filter-tag" data-tier="mega">Mega</button>
          <button class="filter-tag" data-tier="major">Major</button>
          <button class="filter-tag" data-tier="notable">Notable</button>
        </div>
      </div>
      <div class="filter-group">
        <h3>When</h3>
        <div class="filter-tags" id="when-tags">
          <button class="filter-tag active" data-when="all">All upcoming</button>
          <button class="filter-tag" data-when="30">Next 30 days</button>
          <button class="filter-tag" data-when="90">Next 3 months</button>
        </div>
      </div>
    </div>
    <div class="event-list" id="event-list"></div>
    <div class="sidebar-footer">
      <a href="https://github.com/CaptainDarkHeart/eventmap" target="_blank" rel="noopener" aria-label="GitHub repository" title="GitHub repository">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
      </a>
    </div>
  </aside>

  <div class="map-container">
    <div id="map"></div>
    <a class="list-link" href="/events">View all events &rarr;</a>
  </div>
</div>

<script define:vars={{ events, cartoKey }}>
function outboundUrl(url, slug) {
  try {
    const u = new URL(url);
    u.searchParams.set("utm_source", "techeventsmap.com");
    u.searchParams.set("utm_medium", "referral");
    u.searchParams.set("utm_campaign", slug);
    return u.toString();
  } catch {
    return url;
  }
}
const TOPICS = {
  "startup-vc": { label: "Startup / VC", color: "#e04a2e" },
  "fintech": { label: "Fintech", color: "#2a6898" },
  "ai": { label: "AI", color: "#7c3aed" },
  "dev-eng": { label: "Dev / Eng", color: "#3a7a30" },
  "general-tech": { label: "General tech", color: "#b8860b" },
  "crypto": { label: "Crypto", color: "#a08a00" },
  "gaming": { label: "Gaming", color: "#c23b7a" },
  "security": { label: "Security", color: "#666666" },
};
const TIER_LABEL = { mega: "Mega", major: "Major", notable: "Notable" };

function applyTheme(theme) {
  document.documentElement.classList.toggle("dark", theme === "dark");
  localStorage.setItem("em_theme", theme);
}
(function () {
  var saved = localStorage.getItem("em_theme");
  var theme = saved || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  document.documentElement.classList.toggle("dark", theme === "dark");
})();

// build topic filter buttons
const topicTagsEl = document.getElementById("topic-tags");
Object.entries(TOPICS).forEach(([key, meta]) => {
  const btn = document.createElement("button");
  btn.className = "filter-tag";
  btn.dataset.topic = key;
  btn.innerHTML = `<span class="dot" style="background:${meta.color}"></span>${meta.label}`;
  topicTagsEl.appendChild(btn);
});

function tileUrl(dark) {
  const style = dark ? "dark_all" : "voyager";
  return `https://basemaps.cartocdn.com/rastertiles/${style}/{z}/{x}/{y}{r}.png?key=${cartoKey}`;
}

const map = L.map("map", {
  zoomControl: true,
  worldCopyJump: true,
  minZoom: 3,
  maxBounds: [[-85, -Infinity], [85, Infinity]],
  maxBoundsViscosity: 1.0,
}).setView([20, 10], 3);
let tileLayer = L.tileLayer(tileUrl(document.documentElement.classList.contains("dark")), {
  attribution: "&copy; OpenStreetMap &copy; CARTO",
  maxZoom: 19,
}).addTo(map);

function fmtDate(s, e) {
  const opts = { month: "short", day: "numeric" };
  const sd = new Date(s + "T00:00:00");
  const ed = new Date(e + "T00:00:00");
  const sStr = sd.toLocaleDateString("en-GB", opts);
  if (s === e) return sStr;
  return `${sStr} – ${ed.toLocaleDateString("en-GB", opts)}`;
}

function ymd(s) {
  return s.replace(/-/g, "");
}
function addDay(s) {
  const d = new Date(s + "T00:00:00Z");
  d.setUTCDate(d.getUTCDate() + 1);
  return d.toISOString().slice(0, 10);
}
function gcalLink(ev) {
  const params = new URLSearchParams({
    action: "TEMPLATE",
    text: ev.name,
    dates: `${ymd(ev.start)}/${ymd(addDay(ev.end))}`,
    details: ev.url || `https://techeventsmap.com/events/${ev.slug}`,
    location: `${ev.city}, ${ev.country}`,
  });
  return `https://calendar.google.com/calendar/render?${params.toString()}`;
}

const sorted = [...events].sort((a, b) => a.start.localeCompare(b.start));
const listEl = document.getElementById("event-list");

// Many sources give a generic city centroid rather than a venue address, so
// events in the same city land on the exact same lat/lng and permanently
// overlap at every zoom level. Spread duplicates onto a small spiral around
// the shared point so they separate as you zoom in.
const coordCounts = {};

const items = sorted.map((ev) => {
  const color = TOPICS[ev.topics[0]]?.color || "#999";
  const radius = ev.tier === "mega" ? 9 : ev.tier === "major" ? 7 : 5;

  const coordKey = `${ev.lat},${ev.lng}`;
  const dupIndex = coordCounts[coordKey] || 0;
  coordCounts[coordKey] = dupIndex + 1;
  let plotLat = ev.lat, plotLng = ev.lng;
  if (dupIndex > 0) {
    const angle = dupIndex * 2.399963229728653; // golden angle, spreads points evenly
    const spread = 0.008 * Math.sqrt(dupIndex); // ~0.9km per sqrt(step)
    plotLat += spread * Math.cos(angle);
    plotLng += (spread * Math.sin(angle)) / Math.cos((ev.lat * Math.PI) / 180);
  }

  const marker = L.circleMarker([plotLat, plotLng], {
    radius, color, weight: 1.5, fillColor: color, fillOpacity: 0.8,
  });
  const url = ev.url ? `<a href="${outboundUrl(ev.url, ev.slug)}" target="_blank" rel="noopener">${ev.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}</a>` : "";
  const links = `<div class="popup-links"><a href="/events/${ev.slug}">Details</a> &middot; <a href="${gcalLink(ev)}" target="_blank" rel="noopener">+ Google Calendar</a></div>`;
  marker.bindPopup(`<strong>${ev.name}</strong><br/>${ev.city}, ${ev.country}<br/>${fmtDate(ev.start, ev.end)}${url ? "<br/>" + url : ""}${links}`);
  marker.addTo(map);
  marker.on("click", () => selectCard(ev.slug));

  const card = document.createElement("div");
  card.className = "event-card";
  card.id = `card-${ev.slug}`;
  card.innerHTML = `
    <div class="name"><span class="dot" style="background:${color}"></span>${ev.name}</div>
    <div class="meta">${fmtDate(ev.start, ev.end)} &middot; ${ev.city}, ${ev.country}</div>
    <div class="tags"><span class="mini-tag ${ev.tier}">${TIER_LABEL[ev.tier]}</span></div>
    <div class="card-links"><a href="/events/${ev.slug}">Details</a></div>
  `;
  card.addEventListener("click", (e) => {
    if (e.target.closest("a")) return;
    focusEvent(ev.slug);
  });
  listEl.appendChild(card);

  return { ev, marker, card, plotLat, plotLng };
});

const state = { topic: "all", tier: "all", when: "all", q: "" };

function applyFilters() {
  const now = new Date();
  const cutoff = state.when === "all" ? null : new Date(now.getTime() + Number(state.when) * 86400000);
  let visibleCount = 0;
  for (const { ev, marker, card } of items) {
    const topicOk = state.topic === "all" || ev.topics.includes(state.topic);
    const tierOk = state.tier === "all" || ev.tier === state.tier;
    const endDate = new Date(ev.end + "T23:59:59");
    const upcoming = endDate >= now;
    const whenOk = state.when === "all" ? upcoming : upcoming && new Date(ev.start + "T00:00:00") <= cutoff;
    const q = state.q.trim().toLowerCase();
    const searchOk = !q || ev.name.toLowerCase().includes(q) || ev.city.toLowerCase().includes(q) || ev.country.toLowerCase().includes(q);
    const visible = topicOk && tierOk && whenOk && searchOk;

    if (visible && !map.hasLayer(marker)) marker.addTo(map);
    if (!visible && map.hasLayer(marker)) map.removeLayer(marker);
    card.style.display = visible ? "" : "none";
    if (visible) visibleCount++;
  }
  const anyVisible = visibleCount > 0;
  listEl.querySelector(".empty-state")?.remove();
  if (!anyVisible) {
    const empty = document.createElement("div");
    empty.className = "empty-state";
    empty.textContent = "No events match these filters.";
    listEl.appendChild(empty);
  }
}
applyFilters();

function selectCard(slug) {
  const match = items.find((i) => i.ev.slug === slug);
  if (!match) return;
  document.querySelectorAll(".event-card.selected").forEach((c) => c.classList.remove("selected"));
  match.card.classList.add("selected");
  match.card.scrollIntoView({ block: "nearest" });
}

function focusEvent(slug) {
  const match = items.find((i) => i.ev.slug === slug);
  if (!match) return;
  const { marker, plotLat, plotLng } = match;
  map.flyTo([plotLat, plotLng], Math.max(map.getZoom(), 12), { duration: 0.6 });
  marker.openPopup();
  selectCard(slug);
}

function tryHashFocus() {
  const slug = window.location.hash.slice(1);
  if (slug) focusEvent(slug);
}
tryHashFocus();
window.addEventListener("hashchange", tryHashFocus);

document.getElementById("topic-tags").addEventListener("click", (e) => {
  const btn = e.target.closest("[data-topic]");
  if (!btn) return;
  document.querySelectorAll("#topic-tags .filter-tag").forEach((b) => b.classList.remove("active"));
  btn.classList.add("active");
  state.topic = btn.dataset.topic;
  applyFilters();
});
document.getElementById("tier-tags").addEventListener("click", (e) => {
  const btn = e.target.closest("[data-tier]");
  if (!btn) return;
  document.querySelectorAll("#tier-tags .filter-tag").forEach((b) => b.classList.remove("active"));
  btn.classList.add("active");
  state.tier = btn.dataset.tier;
  applyFilters();
});
document.getElementById("when-tags").addEventListener("click", (e) => {
  const btn = e.target.closest("[data-when]");
  if (!btn) return;
  document.querySelectorAll("#when-tags .filter-tag").forEach((b) => b.classList.remove("active"));
  btn.classList.add("active");
  state.when = btn.dataset.when;
  applyFilters();
});
document.getElementById("search").addEventListener("input", (e) => {
  state.q = e.target.value;
  applyFilters();
});

document.getElementById("theme-toggle").addEventListener("click", () => {
  const isDark = !document.documentElement.classList.contains("dark");
  applyTheme(isDark ? "dark" : "light");
  tileLayer.setUrl(tileUrl(isDark));
});

const navToggle = document.getElementById("nav-toggle");
const siteNav = document.getElementById("site-nav");
navToggle.addEventListener("click", () => {
  const open = siteNav.classList.toggle("open");
  navToggle.setAttribute("aria-expanded", open ? "true" : "false");
});
</script>
</body>
</html>
