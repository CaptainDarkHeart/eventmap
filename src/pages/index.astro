---
import SiteHeader from "../components/SiteHeader.astro";
import eventsData from "../data/events.json";
import { regionsFor } from "../lib/regions.js";
import { TYPES } from "../lib/areas.mjs";
// areas: "type:key" tokens so /?area=countries:Germany can scope the map (see AreaPage.astro)
const events = eventsData.map((e) => ({
	...e,
	region: regionsFor(e.country),
	areas: Object.entries(TYPES).flatMap(([type, t]) => t.keys(e).map((k) => `${type}:${k}`)),
}));

const cartoKey = import.meta.env.PUBLIC_CARTO_KEY;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Tech Events Map | Global startup &amp; tech conferences</title>
<meta name="description" content="An open source interactive map of tech, startup, AI, fintech and developer conferences around the world.">
<link rel="canonical" href="https://techeventsmap.com/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Tech Events Map">
<meta property="og:title" content="Tech Events Map | Global startup &amp; tech conferences">
<meta property="og:description" content="An open source interactive map of tech, startup, AI, fintech and developer conferences around the world.">
<meta property="og:url" content="https://techeventsmap.com/">
<meta property="og:image" content="https://techeventsmap.com/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Tech Events Map | Global startup &amp; tech conferences">
<meta name="twitter:description" content="An open source interactive map of tech, startup, AI, fintech and developer conferences around the world.">
<meta name="twitter:image" content="https://techeventsmap.com/og-image.png">
<script is:inline type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": "https://techeventsmap.com/#website",
			name: "Tech Events Map",
			url: "https://techeventsmap.com/",
			description: "An open source interactive map of tech, startup, AI and fintech conferences worldwide.",
			publisher: { "@id": "https://techeventsmap.com/#author" },
		},
		{ "@type": "Person", "@id": "https://techeventsmap.com/#author", name: "Dan Taylor", url: "https://dantaylor.me" },
		{
			"@type": "Dataset",
			name: "Tech Events Map: upcoming tech, startup, AI and fintech conferences",
			description: `${events.length} upcoming tech, startup, AI and fintech conferences across ${new Set(events.map((e) => e.country)).size} countries, with dates, cities, coordinates, topics and size tier. Refreshed daily.`,
			url: "https://techeventsmap.com/",
			creator: { "@id": "https://techeventsmap.com/#author" },
			isAccessibleForFree: true,
			keywords: ["tech conferences", "startup events", "AI conferences", "fintech events", "developer conferences"],
			dateModified: new Date().toISOString().slice(0, 10),
			distribution: [{ "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: "https://techeventsmap.com/data/events.csv" }],
		},
	],
})} />
<link rel="icon" href="/favicon.svg">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/rt.css">
<script is:inline src="/rt.js"></script>
<script is:inline src="/track.js" defer></script>
<style is:global>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#ffffff;--surface:#f7f7f7;--surface-2:#ececec;--border:#dddddd;--text:#000000;--text-dim:#666666;--accent:#e00000;--mega:#c04040;--major:#b8860b;--notable:#3a7a30;--font:'PT Sans',-apple-system,sans-serif}
html.dark{--bg:#0e0e0e;--surface:#161616;--surface-2:#222222;--border:#333333;--text:#f2f2f0;--text-dim:#9a9a9a;--accent:#ff2b2b;--mega:#ff6b6b;--major:#e8b84b;--notable:#7fb07f}
html{height:100%;overflow:hidden;overscroll-behavior:none}
body{font-family:var(--font);background:var(--bg);color:var(--text);height:100dvh;overflow:hidden;overscroll-behavior:none;position:relative}
.main{position:fixed;inset:0;display:flex;overflow:hidden}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.sidebar{width:350px;flex-shrink:0;display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--bg);overflow:hidden;padding-top:56px;z-index:850}
.filters{padding:12px 14px;border-bottom:1px solid var(--border);background:var(--surface)}
.filters-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.filters-header{font-family:var(--font);font-size:12.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text)}
.filters-actions{display:flex;align-items:center;gap:8px}
.reset-btn,.collapse-btn{background:none;border:none;font-family:var(--font);font-size:12px;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent);cursor:pointer;padding:2px 4px}
.collapse-btn{color:var(--text-dim);border:1px solid var(--border);border-radius:3px;padding:2px 7px;background:var(--bg)}
.collapse-btn:hover{color:var(--text);border-color:var(--text-dim)}
.filters-body{display:flex;flex-direction:column;gap:10px}
.filters-body.collapsed{display:none}
.filter-group h2{font-family:var(--font);font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-dim);margin-bottom:6px}
.filter-row-split{display:grid;grid-template-columns:1fr;gap:8px}
.filter-tags{display:flex;flex-wrap:wrap;gap:4px}
.filter-tag{font-family:var(--font);font-size:13px;padding:4px 8px;border-radius:4px;border:1px solid var(--border);background:var(--bg);color:var(--text-dim);cursor:pointer;transition:all 0.15s;user-select:none;display:inline-flex;align-items:center;gap:5px}
.filter-tag:hover{border-color:var(--text-dim);color:var(--text)}
.filter-tag.active{background:var(--accent);border-color:var(--accent);color:var(--bg)}
.filter-tag .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.search-wrap{position:relative;margin-bottom:10px}
.search-input{width:100%;background:var(--bg);border:1px solid var(--border);color:var(--text);font-family:var(--font);font-size:15px;padding:7px 10px;border-radius:4px;outline:none}
.search-input::placeholder{color:var(--text-dim)}
.search-input:focus{border-color:var(--accent)}
.area-banner{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 12px;background:color-mix(in srgb,var(--accent) 10%,var(--surface));border-bottom:1px solid var(--border);font-family:var(--font);font-size:12.5px}
.area-banner a{color:var(--accent);text-decoration:none;font-weight:700}
.event-list{flex:1;overflow-y:auto;padding:8px}
.event-list::-webkit-scrollbar{width:5px}
.event-list::-webkit-scrollbar-track{background:transparent}
.event-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
.event-card{padding:11px 12px;border-radius:5px;cursor:pointer;transition:background-color 0.15s,border-color 0.15s;border:1px solid var(--border);background:var(--bg);margin-bottom:6px}
.event-card:hover{background:var(--surface);border-color:var(--text-dim)}
.event-card.selected{background:var(--surface);border-color:var(--accent);box-shadow:inset 3px 0 0 var(--accent)}
.event-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:4px}
.event-card .name{font-size:16px;font-weight:700;display:flex;align-items:center;gap:6px;line-height:1.25}
.event-card .name .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.event-card .meta{font-family:var(--font);font-size:12.5px;color:var(--text-dim);margin-bottom:6px}
.event-card-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px}
.event-card .tags{display:flex;flex-wrap:wrap;gap:4px}
.event-card .card-links{font-family:var(--font);font-size:12px;flex-shrink:0}
.event-card .card-links a{position:relative;z-index:1;color:var(--accent);text-decoration:none}
.event-card .card-links a:hover{text-decoration:underline}
.mini-tag{font-family:var(--font);font-size:11px;padding:2px 6px;border-radius:3px;background:var(--surface-2);color:var(--text-dim);text-transform:uppercase;letter-spacing:0.04em;flex-shrink:0}
.mini-tag.mega{color:var(--mega)}
.mini-tag.major{color:var(--major)}
.mini-tag.notable{color:var(--notable)}
.empty-state{padding:28px 14px;color:var(--text-dim);font-family:var(--font);font-size:14px;text-align:center}
.sidebar-footer{padding:9px 14px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:var(--surface);flex-shrink:0;font-family:var(--font);font-size:12px;color:var(--text-dim)}
.sidebar-footer a{display:inline-flex;align-items:center;gap:6px;color:var(--text-dim);transition:color 0.15s;text-decoration:none}
.sidebar-footer a:hover{color:var(--accent)}
.sidebar-footer svg{width:16px;height:16px;display:block}
.map-container{flex:1;position:relative}
#map{width:100%;height:100%}
.leaflet-container{background:var(--surface)}.pulse-ring{background:none;border:none;pointer-events:none}
.pulse-ring span{display:block;width:100%;height:100%;box-sizing:border-box;border:2px solid;border-radius:50%;opacity:0;animation:pulse-ring 2s ease-out infinite}
@keyframes pulse-ring{0%{transform:scale(.8);opacity:.9}100%{transform:scale(2.6);opacity:0}}
@media (prefers-reduced-motion:reduce){.pulse-ring span{animation:none;opacity:.6;transform:scale(1.5)}}
.leaflet-top{margin-top:68px}
.leaflet-control-zoom{border:1px solid var(--border)!important}
.leaflet-control-zoom a{background:var(--surface)!important;color:var(--text)!important;border-color:var(--border)!important}
.leaflet-control-zoom a:hover{background:var(--surface-2)!important}
.leaflet-control-attribution{background:rgba(255,255,255,0.8)!important;color:var(--text-dim)!important;font-size:11px!important}
html.dark .leaflet-control-attribution{background:rgba(14,14,14,0.8)!important}
.leaflet-control-attribution a{color:var(--text-dim)!important}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:var(--surface);color:var(--text)}
.leaflet-popup-content{font-family:var(--font);font-size:15px}
.leaflet-popup-content a{color:var(--accent)}
.popup-links{margin-top:6px;font-size:13.5px}
.map-floating-bar{position:absolute;bottom:20px;right:20px;z-index:800;display:flex;align-items:center;gap:8px}
.list-link{background:var(--bg);border:1px solid var(--border);padding:8px 14px;border-radius:6px;font-family:var(--font);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;text-decoration:none;color:var(--text);box-shadow:0 4px 16px rgba(0,0,0,0.14);cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.list-link:hover{border-color:var(--accent);color:var(--accent)}
.drawer-toggle-btn{display:none}
.sidebar-close-mobile{display:none}
@media(max-width:960px){
  .sidebar{
    position:fixed;
    left:0;
    right:0;
    bottom:0;
    top:56px;
    width:100%;
    padding-top:0;
    border-right:none;
    border-top:1px solid var(--border);
    transform:translateY(100%);
    transition:transform 0.25s ease;
    z-index:950;
  }
  .sidebar.drawer-open{
    transform:translateY(0);
  }
  .sidebar-close-mobile{
    display:inline-flex;
    background:var(--bg);
    border:1px solid var(--border);
    color:var(--text);
    font-family:var(--font);
    font-size:12px;
    padding:3px 8px;
    border-radius:4px;
    cursor:pointer;
  }
  .leaflet-control-zoom{display:none!important}
  .map-floating-bar{left:16px;right:16px;bottom:16px;justify-content:space-between}
  .drawer-toggle-btn{display:inline-flex;background:var(--accent);border-color:var(--accent);color:var(--bg)}
  .drawer-toggle-btn:hover{color:var(--bg);opacity:0.92}
}
</style>
</head>
<body>
<SiteHeader fixed={true} />

<section class="sr-only" aria-label="About this map">
  <h2>Upcoming tech, startup, AI and fintech conferences</h2>
  <p>Tech Events Map lists {events.length} upcoming conferences in {new Set(events.map((e) => e.country)).size} countries, filterable by topic, size and date. Browse by <a href="/countries/">country</a>, <a href="/cities/">city</a>, <a href="/topics/">topic</a> or <a href="/regions/">region</a>, search <a href="/events/">every event</a>, or <a href="/plan/">plan a trip</a>.</p>
</section>
<div class="main">
  <aside class="sidebar" id="map-sidebar">
    <div class="filters">
      <div class="filters-top">
        <div class="filters-header" id="result-count">{events.length} events</div>
        <div class="filters-actions">
          <button id="reset-filters" class="reset-btn" type="button" hidden>Reset</button>
          <button id="toggle-filters" class="collapse-btn" type="button" aria-expanded="true">Filters &#9662;</button>
          <button id="close-drawer" class="sidebar-close-mobile" type="button">Map &#10005;</button>
        </div>
      </div>
      <div class="search-wrap">
        <input id="search" class="search-input" type="text" placeholder="Search events, cities, regions..." autocomplete="off">
      </div>
      <div class="filters-body" id="filters-body">
        <div class="filter-group">
          <h2>Topic</h2>
          <div class="filter-tags" id="topic-tags">
            <button class="filter-tag active" data-topic="all">All</button>
          </div>
        </div>
        <div class="filter-row-split">
          <div class="filter-group">
            <h2>Size</h2>
            <div class="filter-tags" id="tier-tags">
              <button class="filter-tag active" data-tier="all">All</button>
              <button class="filter-tag" data-tier="mega">Mega</button>
              <button class="filter-tag" data-tier="major">Major</button>
              <button class="filter-tag" data-tier="notable">Notable</button>
            </div>
          </div>
          <div class="filter-group">
            <h2>When</h2>
            <div class="filter-tags" id="when-tags">
              <button class="filter-tag active" data-when="all">All upcoming</button>
              <button class="filter-tag" data-when="30">Next 30d</button>
              <button class="filter-tag" data-when="90">Next 90d</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="event-list" id="event-list"></div>
    <div class="sidebar-footer">
      <a href="/events/">Table &amp; CSV export &rarr;</a>
      <a href="/plan/">Trip planner &rarr;</a>
    </div>
  </aside>

  <div class="map-container">
    <div id="map"></div>
    <div class="map-floating-bar">
      <button id="open-drawer" class="list-link drawer-toggle-btn" type="button">Filter &amp; List (<span id="mobile-count">{events.length}</span>)</button>
      <a class="list-link" href="/events/">Table view &rarr;</a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ events, cartoKey }}>
function outboundUrl(url, slug) {
  try {
    const u = new URL(url);
    u.searchParams.set("utm_source", "techeventsmap.com");
    u.searchParams.set("utm_medium", "referral");
    u.searchParams.set("utm_campaign", slug);
    return u.toString();
  } catch {
    return url;
  }
}
const TOPICS = {
  "startup-vc": { label: "Startup / VC", color: "#e04a2e" },
  "fintech": { label: "Fintech", color: "#2a6898" },
  "ai": { label: "AI", color: "#7c3aed" },
  "dev-eng": { label: "Dev / Eng", color: "#3a7a30" },
  "general-tech": { label: "General tech", color: "#b8860b" },
  "crypto": { label: "Crypto", color: "#a08a00" },
  "gaming": { label: "Gaming", color: "#c23b7a" },
  "security": { label: "Security", color: "#666666" },
};
const TIER_LABEL = { mega: "Mega", major: "Major", notable: "Notable" };

(function () {
  if (window.RT && RT.active()) return;
  var saved = null;
  try { saved = localStorage.getItem("em_theme"); } catch {}
  var theme = saved || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  document.documentElement.classList.toggle("dark", theme === "dark");
})();

// build topic filter buttons
const topicTagsEl = document.getElementById("topic-tags");
Object.entries(TOPICS).forEach(([key, meta]) => {
  const btn = document.createElement("button");
  btn.className = "filter-tag";
  btn.dataset.topic = key;
  btn.innerHTML = `<span class="dot" style="background:${meta.color}"></span>${meta.label}`;
  topicTagsEl.appendChild(btn);
});

function tileUrl(dark) {
  const style = dark ? "dark_all" : "voyager";
  // v= busts stale cached tiles from an older CARTO style (mixed old/new tiles showed as blocks)
  return `https://basemaps.cartocdn.com/rastertiles/${style}/{z}/{x}/{y}{r}.png?key=${cartoKey}&v=2`;
}

const map = L.map("map", {
  zoomControl: true,
  worldCopyJump: true,
  minZoom: 3,
  maxBounds: [[-85, -Infinity], [85, Infinity]],
  maxBoundsViscosity: 1.0,
}).setView([20, 10], 3);
let tileLayer = L.tileLayer(tileUrl(document.documentElement.classList.contains("dark")), {
  attribution: "&copy; OpenStreetMap &copy; CARTO",
  maxZoom: 19,
}).addTo(map);

function fmtDate(s, e) {
  const opts = { month: "short", day: "numeric" };
  const sd = new Date(s + "T00:00:00");
  const ed = new Date(e + "T00:00:00");
  const sStr = sd.toLocaleDateString("en-GB", opts);
  if (s === e) return sStr;
  return `${sStr} – ${ed.toLocaleDateString("en-GB", opts)}`;
}

function ymd(s) {
  return s.replace(/-/g, "");
}
function addDay(s) {
  const d = new Date(s + "T00:00:00Z");
  d.setUTCDate(d.getUTCDate() + 1);
  return d.toISOString().slice(0, 10);
}
function gcalLink(ev) {
  const params = new URLSearchParams({
    action: "TEMPLATE",
    text: ev.name,
    dates: `${ymd(ev.start)}/${ymd(addDay(ev.end))}`,
    details: ev.url || `https://techeventsmap.com/events/${ev.slug}/`,
    location: `${ev.city}, ${ev.country}`,
  });
  return `https://calendar.google.com/calendar/render?${params.toString()}`;
}

const sorted = [...events].sort((a, b) => a.start.localeCompare(b.start));
const listEl = document.getElementById("event-list");
const resultCountEl = document.getElementById("result-count");
const mobileCountEl = document.getElementById("mobile-count");
const resetBtn = document.getElementById("reset-filters");
const mapSidebar = document.getElementById("map-sidebar");

// Many sources give a generic city centroid rather than a venue address, so
// events in the same city land on the exact same lat/lng and permanently
// overlap at every zoom level. Spread duplicates onto a small spiral around
// the shared point so they separate as you zoom in.
const coordCounts = {};

const items = sorted.map((ev) => {
  const color = TOPICS[ev.topics[0]]?.color || "#999";
  const radius = ev.tier === "mega" ? 9 : ev.tier === "major" ? 7 : 5;

  const coordKey = `${ev.lat},${ev.lng}`;
  const dupIndex = coordCounts[coordKey] || 0;
  coordCounts[coordKey] = dupIndex + 1;
  let plotLat = ev.lat, plotLng = ev.lng;
  if (dupIndex > 0) {
    const angle = dupIndex * 2.399963229728653; // golden angle, spreads points evenly
    const spread = 0.008 * Math.sqrt(dupIndex); // ~0.9km per sqrt(step)
    plotLat += spread * Math.cos(angle);
    plotLng += (spread * Math.sin(angle)) / Math.cos((ev.lat * Math.PI) / 180);
  }

  const marker = L.circleMarker([plotLat, plotLng], {
    radius, color, weight: 1.5, fillColor: color, fillOpacity: 0.8,
  });
  const url = ev.url ? `<a href="${outboundUrl(ev.url, ev.slug)}" target="_blank" rel="noopener">${ev.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}</a>` : "";
  const links = `<div class="popup-links"><a href="/events/${ev.slug}/">Details</a> &middot; <a href="${gcalLink(ev)}" target="_blank" rel="noopener">+ Google Calendar</a></div>`;
  marker.bindPopup(`<strong>${ev.name}</strong><br/>${ev.city}, ${ev.country}<br/>${fmtDate(ev.start, ev.end)}${url ? "<br/>" + url : ""}${links}`);
  marker.addTo(map);
  marker.on("click", () => selectCard(ev.slug));

  // Pulsing ring on events running today (start <= today <= end).
  // Non-interactive divIcon so clicks fall through to the dot beneath.
  let pulse = null;
  const now = new Date();
  const isActive = new Date(ev.start + "T00:00:00") <= now && new Date(ev.end + "T23:59:59") >= now;
  if (isActive) {
    const size = radius * 2 + 4;
    pulse = L.marker([plotLat, plotLng], {
      interactive: false,
      keyboard: false,
      icon: L.divIcon({
        className: "pulse-ring",
        html: `<span style="border-color:${color}"></span>`,
        iconSize: [size, size],
        iconAnchor: [size / 2, size / 2],
      }),
    });
  }

  const topicBadges = ev.topics.slice(0, 2).map((t) => `<span class="mini-tag">${TOPICS[t]?.label || t}</span>`).join("");
  const card = document.createElement("div");
  card.className = "event-card";
  card.id = `card-${ev.slug}`;
  card.innerHTML = `
    <div class="event-card-top">
      <div class="name"><span class="dot" style="background:${color}"></span>${ev.name}</div>
      <span class="mini-tag ${ev.tier}">${TIER_LABEL[ev.tier]}</span>
    </div>
    <div class="meta">${fmtDate(ev.start, ev.end)} &middot; ${ev.city}, ${ev.country}</div>
    <div class="event-card-bottom">
      <div class="tags">${topicBadges}</div>
      <div class="card-links"><a href="/events/${ev.slug}/">Details &rarr;</a></div>
    </div>
  `;
  card.addEventListener("click", (e) => {
    if (e.target.closest("a")) return;
    mapSidebar.classList.remove("drawer-open");
    focusEvent(ev.slug);
  });
  listEl.appendChild(card);

  return { ev, marker, pulse, card, plotLat, plotLng };
});

const areaParam = new URLSearchParams(window.location.search).get("area");
const state = { topic: "all", tier: "all", when: "all", q: "", area: areaParam || "" };

function applyFilters() {
  const now = new Date();
  const cutoff = state.when === "all" ? null : new Date(now.getTime() + Number(state.when) * 86400000);
  let visibleCount = 0;
  for (const { ev, marker, pulse, card } of items) {
    const topicOk = state.topic === "all" || ev.topics.includes(state.topic);
    const tierOk = state.tier === "all" || ev.tier === state.tier;
    const endDate = new Date(ev.end + "T23:59:59");
    const upcoming = endDate >= now;
    const whenOk = state.when === "all" ? upcoming : upcoming && new Date(ev.start + "T00:00:00") <= cutoff;
    const q = state.q.trim().toLowerCase();
    const searchOk = !q || ev.name.toLowerCase().includes(q) || ev.city.toLowerCase().includes(q) || ev.country.toLowerCase().includes(q) || (ev.region || "").includes(q);
    const areaOk = !state.area || ev.areas.includes(state.area);
    const visible = topicOk && tierOk && whenOk && searchOk && areaOk;

    if (visible && !map.hasLayer(marker)) marker.addTo(map);
    if (!visible && map.hasLayer(marker)) map.removeLayer(marker);
    if (pulse) {
      if (visible && !map.hasLayer(pulse)) pulse.addTo(map);
      if (!visible && map.hasLayer(pulse)) map.removeLayer(pulse);
    }
    card.style.display = visible ? "" : "none";
    if (visible) visibleCount++;
  }
  const hasActiveFilter = state.topic !== "all" || state.tier !== "all" || state.when !== "all" || state.q.trim() !== "" || state.area !== "";
  resultCountEl.textContent = hasActiveFilter ? `${visibleCount} of ${items.length} events` : `${visibleCount} events`;
  if (mobileCountEl) mobileCountEl.textContent = String(visibleCount);
  if (resetBtn) resetBtn.hidden = !hasActiveFilter;

  const anyVisible = visibleCount > 0;
  listEl.querySelector(".empty-state")?.remove();
  if (!anyVisible) {
    const empty = document.createElement("div");
    empty.className = "empty-state";
    empty.textContent = "No events match these filters.";
    listEl.appendChild(empty);
  }
}
applyFilters();

function fitToVisible() {
  const pts = items.filter((i) => map.hasLayer(i.marker)).map((i) => [i.plotLat, i.plotLng]);
  if (!pts.length) return;
  map.invalidateSize();
  // Cities: tight zoom so the dots fill the view. Wider areas are bounded by their spread anyway.
  map.fitBounds(pts, { padding: [30, 30], maxZoom: state.area.startsWith("cities:") ? 13 : 10, animate: false });
}
if (state.area) {
  const label = state.area.split(":")[1].split("|")[0];
  const chip = document.createElement("div");
  chip.className = "area-banner";
  chip.innerHTML = `<span>Scoped: <strong>${label}</strong></span><a href="/">Show all &times;</a>`;
  listEl.parentNode.insertBefore(chip, listEl);
  fitToVisible();
}

function selectCard(slug) {
  const match = items.find((i) => i.ev.slug === slug);
  if (!match) return;
  document.querySelectorAll(".event-card.selected").forEach((c) => c.classList.remove("selected"));
  match.card.classList.add("selected");
  match.card.scrollIntoView({ block: "nearest" });
}

function focusEvent(slug) {
  const match = items.find((i) => i.ev.slug === slug);
  if (!match) return;
  const { marker, plotLat, plotLng } = match;
  map.flyTo([plotLat, plotLng], Math.max(map.getZoom(), 12), { duration: 0.6 });
  marker.openPopup();
  selectCard(slug);
}

function tryHashFocus() {
  const slug = window.location.hash.slice(1);
  if (slug) focusEvent(slug);
}
tryHashFocus();
window.addEventListener("hashchange", tryHashFocus);

document.getElementById("topic-tags").addEventListener("click", (e) => {
  const btn = e.target.closest("[data-topic]");
  if (!btn) return;
  document.querySelectorAll("#topic-tags .filter-tag").forEach((b) => b.classList.remove("active"));
  btn.classList.add("active");
  state.topic = btn.dataset.topic;
  applyFilters();
});
document.getElementById("tier-tags").addEventListener("click", (e) => {
  const btn = e.target.closest("[data-tier]");
  if (!btn) return;
  document.querySelectorAll("#tier-tags .filter-tag").forEach((b) => b.classList.remove("active"));
  btn.classList.add("active");
  state.tier = btn.dataset.tier;
  applyFilters();
});
document.getElementById("when-tags").addEventListener("click", (e) => {
  const btn = e.target.closest("[data-when]");
  if (!btn) return;
  document.querySelectorAll("#when-tags .filter-tag").forEach((b) => b.classList.remove("active"));
  btn.classList.add("active");
  state.when = btn.dataset.when;
  applyFilters();
});
resetBtn?.addEventListener("click", () => {
  state.topic = "all";
  state.tier = "all";
  state.when = "all";
  state.q = "";
  state.area = "";
  document.getElementById("search").value = "";
  document.querySelectorAll("#topic-tags .filter-tag, #tier-tags .filter-tag, #when-tags .filter-tag").forEach((b) => {
    b.classList.toggle("active", b.dataset.topic === "all" || b.dataset.tier === "all" || b.dataset.when === "all");
  });
  document.querySelector(".area-banner")?.remove();
  applyFilters();
});

const toggleFiltersBtn = document.getElementById("toggle-filters");
const filtersBody = document.getElementById("filters-body");
toggleFiltersBtn?.addEventListener("click", () => {
  const collapsed = filtersBody.classList.toggle("collapsed");
  toggleFiltersBtn.setAttribute("aria-expanded", collapsed ? "false" : "true");
  toggleFiltersBtn.innerHTML = collapsed ? "Filters &#9656;" : "Filters &#9662;";
});

document.getElementById("open-drawer")?.addEventListener("click", () => {
  mapSidebar.classList.add("drawer-open");
});
document.getElementById("close-drawer")?.addEventListener("click", () => {
  mapSidebar.classList.remove("drawer-open");
});

// secret terminal theme (see public/rt.js): keep basemap in step when it flips on/off
if (window.RT) RT.onChange(() => tileLayer.setUrl(tileUrl(document.documentElement.classList.contains("dark"))));
window.addEventListener("em-theme-change", (e) => {
  tileLayer.setUrl(tileUrl(e.detail.dark));
});
document.getElementById("search").addEventListener("input", (e) => {
  state.q = e.target.value;
  applyFilters();
});
</script>
</body>
</html>
