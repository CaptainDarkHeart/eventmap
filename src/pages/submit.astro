---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { TOPICS } from "../lib/topics";

const TURNSTILE_SITEKEY = "0x4AAAAAAEwHeenj5gz4VHU9";
---
<Layout title="Submit an Event | Tech Events Map" description="Know a tech, startup, AI or fintech conference that's missing? Submit it to Tech Events Map." breadcrumbs={[{ name: "Home", path: "/" }, { name: "Submit Event", path: "/submit/" }]}>
	<SiteHeader />
	<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
	<main class="wrap-wide">
		<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>Submit Event</nav>
		<div class="page-head">
			<h1>Submit an Event</h1>
			<p class="sub">Know a tech, startup, AI or fintech conference that isn't on the map? Fill in the details below.</p>
		</div>

		<div class="submit-split">
			<form id="submit-form" class="card form-card">
				<input type="text" name="company" tabindex="-1" autocomplete="off" class="hp-field" />

				<label>Event name *<input type="text" name="name" required maxlength="150" placeholder="e.g. Slush 2026" /></label>
				<label>Official website *<input type="text" name="url" required maxlength="300" placeholder="https://event.example.com" /></label>

				<div class="row">
					<label>City *<input type="text" name="city" required maxlength="100" placeholder="e.g. Helsinki" /></label>
					<label>Country *<input type="text" name="country" required maxlength="100" placeholder="e.g. Finland" /></label>
				</div>

				<div class="row">
					<label>Start date *<input type="date" name="start" required /></label>
					<label>End date<input type="date" name="end" /></label>
				</div>

				<fieldset>
					<legend>Topics *</legend>
					<div class="topic-pills">
						{Object.entries(TOPICS).map(([key, t]) => (
							<label class="topic-pill">
								<input type="checkbox" name="topics" value={key} />
								<span class="dot" style={`background:${t.color}`}></span>
								<span>{t.label}</span>
							</label>
						))}
					</div>
				</fieldset>

				<label>Anything else?<textarea name="notes" maxlength="500" rows="3" placeholder="Optional notes on size, venue or organiser..."></textarea></label>
				<label>Your email (optional, in case I have questions)<input type="email" name="submitterEmail" maxlength="200" placeholder="you@example.com" /></label>

				<div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>

				<div class="submit-row">
					<button type="submit" class="btn btn-primary">Submit event</button>
					<p id="submit-result" role="status"></p>
				</div>
			</form>

			<aside class="info-col">
				<div class="card info-card">
					<span class="kicker">How verification works</span>
					<h2>Automated Checks</h2>
					<ul class="steps-list">
						<li><strong>1. Live URL check:</strong> I verify that the event website responds and mentions the event name and start date.</li>
						<li><strong>2. Dual geocoding:</strong> The city and country are cross-checked across two independent geocoders to place the pin accurately.</li>
						<li><strong>3. Instant publishing:</strong> If every check passes, the conference is committed directly to the live map. If a site blocks bots or renders dates via client-side scripts, it lands in my inbox for manual review.</li>
					</ul>
				</div>

				<div class="card info-card">
					<span class="kicker">Existing Listings</span>
					<h2>Spotted an Error?</h2>
					<p>If an event already on the map has changed its dates, venue, or website, let me know and I will update the listing.</p>
					<a class="btn" href="/contact/">Contact Me &rarr;</a>
				</div>
			</aside>
		</div>
	</main>
</Layout>

<style>
	.page-head {
		margin-bottom: 24px;
	}
	h1 {
		margin: 0 0 6px;
		font-size: 32px;
		font-weight: 700;
		line-height: 1.15;
	}
	.sub {
		color: var(--text-dim);
		font-size: 16.5px;
		margin: 0;
	}
	.submit-split {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
		gap: 28px;
		align-items: start;
	}
	.form-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	form label {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: var(--font);
		font-size: 12px;
		font-weight: 700;
		color: var(--text-dim);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	form input[type="text"], form input[type="email"], form input[type="date"], form textarea {
		padding: 9px 12px;
		font-family: var(--font);
		font-size: 16px;
		font-weight: 400;
		text-transform: none;
		letter-spacing: normal;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 5px;
		outline: none;
	}
	form input:focus, form textarea:focus {
		border-color: var(--accent);
	}
	form textarea {
		resize: vertical;
	}
	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
	}
	form fieldset {
		border: 1px solid var(--border);
		border-radius: 5px;
		padding: 12px 14px;
		margin: 0;
		background: var(--bg);
	}
	form fieldset legend {
		padding: 0 6px;
		font-family: var(--font);
		font-size: 12px;
		font-weight: 700;
		color: var(--text-dim);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.topic-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.topic-pill {
		display: inline-flex;
		flex-direction: row;
		align-items: center;
		gap: 6px;
		padding: 5px 11px;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--surface);
		font-family: var(--font);
		font-size: 14px;
		font-weight: 400;
		text-transform: none;
		letter-spacing: normal;
		color: var(--text);
		cursor: pointer;
		user-select: none;
	}
	.topic-pill input {
		margin: 0;
		accent-color: var(--accent);
	}
	.topic-pill:has(input:checked) {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, var(--surface));
	}
	.topic-pill .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
	}
	.hp-field {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.submit-row {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}
	form button:disabled {
		opacity: 0.6;
		cursor: default;
	}
	#submit-result {
		font-size: 14.5px;
		margin: 0;
		font-family: var(--font);
	}
	.info-col {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.kicker {
		display: block;
		font-family: var(--font);
		font-size: 11.5px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		margin-bottom: 4px;
	}
	.info-card h2 {
		margin: 0 0 10px;
		font-size: 19px;
	}
	.info-card p {
		margin: 0 0 10px;
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--text-dim);
	}
	.info-card p:last-child {
		margin-bottom: 0;
	}
	.info-card a {
		color: var(--accent);
	}
	.steps-list {
		margin: 0;
		padding-left: 18px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		font-size: 15px;
		line-height: 1.5;
		color: var(--text-dim);
	}
	.steps-list strong {
		color: var(--text);
	}
	@media (max-width: 820px) {
		.submit-split {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 520px) {
		.row {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const form = document.getElementById("submit-form") as HTMLFormElement;
	const resultEl = document.getElementById("submit-result") as HTMLParagraphElement;
	const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement;

	const startInput = form.querySelector("input[name=start]") as HTMLInputElement;
	const endInput = form.querySelector("input[name=end]") as HTMLInputElement;
	// An end date before the start date is never valid, so block it in the picker itself
	startInput.addEventListener("change", () => {
		endInput.min = startInput.value;
	});

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (endInput.value && startInput.value && endInput.value < startInput.value) {
			resultEl.textContent = "The end date can't be before the start date.";
			return;
		}
		resultEl.textContent = "Submitting...";
		submitBtn.disabled = true;

		const fd = new FormData(form);
		if (String(fd.get("company") || "").trim() !== "") {
			resultEl.textContent = "";
			submitBtn.disabled = false;
			return;
		}

		const payload = {
			company: fd.get("company"),
			name: fd.get("name"),
			url: fd.get("url"),
			city: fd.get("city"),
			country: fd.get("country"),
			start: fd.get("start"),
			end: fd.get("end"),
			topics: fd.getAll("topics"),
			notes: fd.get("notes"),
			submitterEmail: fd.get("submitterEmail"),
			turnstileToken: fd.get("cf-turnstile-response"),
		};

		try {
			const res = await fetch("/api/submit-event", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const data = await res.json();
			resultEl.textContent = data.message || data.error || "Something went wrong.";
			if (data.ok) form.reset();
		} catch {
			resultEl.textContent = "Network error, please try again.";
		} finally {
			submitBtn.disabled = false;
		}
	});
</script>
