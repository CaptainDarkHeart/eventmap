---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { TOPICS, TIERS } from "../../lib/topics";
import events from "../../data/events.json";
import { regionsFor } from "../../lib/regions.js";

const sorted = [...events].sort((a, b) => a.start.localeCompare(b.start));

function ymd(s: string) {
	return s.replace(/-/g, "");
}
function addDay(s: string) {
	const d = new Date(s + "T00:00:00Z");
	d.setUTCDate(d.getUTCDate() + 1);
	return d.toISOString().slice(0, 10);
}
function gcalUrl(ev: (typeof events)[number]) {
	const params = new URLSearchParams({
		action: "TEMPLATE",
		text: ev.name,
		dates: `${ymd(ev.start)}/${ymd(addDay(ev.end))}`,
		details: ev.url || `https://techeventsmap.com/events/${ev.slug}/`,
		location: `${ev.city}, ${ev.country}`,
	});
	return `https://calendar.google.com/calendar/render?${params.toString()}`;
}

function fmtDate(s: string, e: string) {
	const opts: Intl.DateTimeFormatOptions = { month: "short", day: "numeric", year: "numeric" };
	const sd = new Date(s + "T00:00:00");
	const ed = new Date(e + "T00:00:00");
	const sStr = sd.toLocaleDateString("en-GB", { month: "short", day: "numeric" });
	if (s === e) return sd.toLocaleDateString("en-GB", opts);
	const eStr = ed.toLocaleDateString("en-GB", opts);
	return `${sStr} - ${eStr}`;
}
---
<Layout title="All events | Tech Events Map" description="Open source directory of tech, startup, AI and fintech events worldwide, listed by date." breadcrumbs={[{ name: "Home", path: "/" }, { name: "All events", path: "/events/" }]}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "ItemList",
		itemListElement: sorted.slice(0, 50).map((ev, i) => ({
			"@type": "ListItem",
			position: i + 1,
			url: `https://techeventsmap.com/events/${ev.slug}/`,
			name: ev.name,
		})),
	})} />
	<SiteHeader />
	<main class="wrap-wide">
		<div class="page-head">
			<div>
				<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>All events</nav>
				<h1 id="dir-caption">All events</h1>
				<p class="sub">Open source directory of tech, startup, AI and fintech conferences worldwide.</p>
			</div>
			<div class="head-actions">
				<a class="btn" href="https://calendar.google.com/calendar/render?cid=https://techeventsmap.com/events.ics" target="_blank" rel="noopener">+ Google Calendar</a>
				<a class="btn" href="/events.ics" rel="nofollow">Subscribe (.ics)</a>
				<button id="csv-btn" class="btn" type="button">Export CSV</button>
			</div>
		</div>

		<section class="filter-panel card" aria-label="Filter events">
			<div class="search-bar-row">
				<input id="search" class="search-input" type="text" placeholder="Search events, cities, countries, regions, topics..." autocomplete="off" />
				<div class="count-box">
					<span id="visible-count" class="count-pill">{sorted.length} events</span>
					<button id="reset-all" class="reset-link" type="button" hidden>Reset</button>
				</div>
			</div>
			<div class="filter-groups">
				<div class="f-group">
					<span class="f-label">Topic</span>
					<div class="filter-tags" id="topic-tags">
						<button class="filter-tag active" type="button" data-topic="all">All</button>
						{Object.entries(TOPICS).map(([key, t]) => (
							<button class="filter-tag" type="button" data-topic={key}>
								<span class="dot" style={`background:${t.color}`}></span>{t.label}
							</button>
						))}
					</div>
				</div>
				<div class="f-group-split">
					<div class="f-group">
						<span class="f-label">Size</span>
						<div class="filter-tags" id="tier-tags">
							<button class="filter-tag active" type="button" data-tier="all">All</button>
							<button class="filter-tag" type="button" data-tier="mega">Mega</button>
							<button class="filter-tag" type="button" data-tier="major">Major</button>
							<button class="filter-tag" type="button" data-tier="notable">Notable</button>
						</div>
					</div>
					<div class="f-group">
						<span class="f-label">When</span>
						<div class="filter-tags" id="when-tags">
							<button class="filter-tag active" type="button" data-when="all">All upcoming</button>
							<button class="filter-tag" type="button" data-when="30">Next 30d</button>
							<button class="filter-tag" type="button" data-when="90">Next 90d</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<p id="empty" class="empty" hidden>No events match these filters.</p>
		<div class="table-wrap" tabindex="0" role="region" aria-labelledby="dir-caption">
			<table id="events-table">
				<thead>
					<tr>
						<th scope="col" aria-sort="none">
							<button type="button" class="sort-btn" data-col="name" title="Sort by Event (ascending)">
								<span class="sort-label">Event</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th scope="col" aria-sort="ascending">
							<button type="button" class="sort-btn" data-col="date" title="Sort by Dates (descending)">
								<span class="sort-label">Dates</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th scope="col" aria-sort="none">
							<button type="button" class="sort-btn" data-col="country" title="Sort by Country (ascending)">
								<span class="sort-label">Location</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th scope="col" aria-sort="none">
							<button type="button" class="sort-btn" data-col="topic" title="Sort by Topic (ascending)">
								<span class="sort-label">Topic</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th scope="col" aria-sort="none">
							<button type="button" class="sort-btn" data-col="size" title="Sort by Size (descending)">
								<span class="sort-label">Size</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th class="cal-col" scope="col"><span class="sr-only">Calendar</span></th>
					</tr>
				</thead>
				<tbody>
					{sorted.map((ev) => (
						<tr
							data-name={ev.name.toLowerCase()}
							data-start={ev.start}
							data-city={ev.city.toLowerCase()}
							data-country={ev.country.toLowerCase()}
							data-region={regionsFor(ev.country)}
							data-topic-keys={ev.topics.join(",")}
							data-topics={ev.topics.map((t) => TOPICS[t]?.label ?? t).join(", ").toLowerCase()}
							data-tier={ev.tier}
							data-tier-rank={ev.tier === "mega" ? 3 : ev.tier === "major" ? 2 : 1}
							data-csv={JSON.stringify([ev.name, ev.start, ev.end, ev.city, ev.country, ev.topics.map((t) => TOPICS[t]?.label ?? t).join("; "), TIERS[ev.tier], ev.url ?? ""])}
						>
							<th scope="row" class="ev-cell"><a href={`/events/${ev.slug}/`}>{ev.name}</a></th>
							<td class="date-cell">{fmtDate(ev.start, ev.end)}</td>
							<td class="loc-cell">{ev.city}, {ev.country}</td>
							<td class="topic-cell">
								<div class="topic-badges">
									{ev.topics.map((t) => (
										<span class="topic-chip">
											<span class="dot" style={`background:${TOPICS[t]?.color ?? "#999"}`}></span>
											{TOPICS[t]?.label ?? t}
										</span>
									))}
								</div>
							</td>
							<td class={`tier-cell tier-${ev.tier}`}>{TIERS[ev.tier]}</td>
							<td class="cal-col">
								<a class="cal-link" href={gcalUrl(ev)} target="_blank" rel="noopener" title={`Add ${ev.name} to Google Calendar`}>+GCal</a>
								<a class="cal-link" href={`/events/${ev.slug}.ics`} rel="nofollow" title={`Download ${ev.name} for Apple / Outlook`}>.ics</a>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</main>
</Layout>

<script>
	type SortCol = "name" | "date" | "country" | "topic" | "size";
	type SortDir = "asc" | "desc";

	const search = document.getElementById("search") as HTMLInputElement;
	const tbody = document.querySelector("#events-table tbody") as HTMLTableSectionElement;
	const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("#events-table tbody tr"));
	const empty = document.getElementById("empty") as HTMLElement;
	const topicTags = document.getElementById("topic-tags") as HTMLElement;
	const tierTags = document.getElementById("tier-tags") as HTMLElement;
	const whenTags = document.getElementById("when-tags") as HTMLElement;
	const visibleCountEl = document.getElementById("visible-count") as HTMLElement;
	const resetAllBtn = document.getElementById("reset-all") as HTMLButtonElement;
	const sortThs = Array.from(document.querySelectorAll<HTMLTableCellElement>("#events-table thead th[aria-sort]"));

	let activeTopic = "all";
	let activeTier = "all";
	let activeWhen = "all";
	let currentSortCol: SortCol = "date";
	let currentSortDir: SortDir = "asc";

	function applyFilters() {
		const q = search.value.trim().toLowerCase();
		const now = new Date();
		const cutoff = activeWhen === "all" ? null : new Date(now.getTime() + Number(activeWhen) * 86400000).toISOString().slice(0, 10);
		let visibleCount = 0;
		for (const row of rows) {
			const topicKeys = (row.dataset.topicKeys ?? "").split(",");
			const topicOk = activeTopic === "all" || topicKeys.includes(activeTopic);
			const tierOk = activeTier === "all" || row.dataset.tier === activeTier;
			const start = row.dataset.start ?? "";
			const whenOk = !cutoff || start <= cutoff;
			const searchOk =
				!q ||
				(row.dataset.name ?? "").includes(q) ||
				(row.dataset.city ?? "").includes(q) ||
				(row.dataset.country ?? "").includes(q) ||
				(row.dataset.region ?? "").includes(q) ||
				(row.dataset.topics ?? "").includes(q);
			const visible = topicOk && tierOk && whenOk && searchOk;
			row.hidden = !visible;
			if (visible) visibleCount++;
		}
		empty.hidden = visibleCount > 0;
		const filtered = activeTopic !== "all" || activeTier !== "all" || activeWhen !== "all" || q !== "";
		visibleCountEl.textContent = filtered ? `${visibleCount} of ${rows.length} events` : `${visibleCount} events`;
		resetAllBtn.hidden = !filtered;
	}

	function updateHeaderState() {
		for (const th of sortThs) {
			const btn = th.querySelector<HTMLButtonElement>(".sort-btn");
			if (!btn) continue;
			const col = btn.dataset.col as SortCol;
			const label = btn.querySelector(".sort-label")?.textContent ?? col;
			if (col === currentSortCol) {
				const ariaSort = currentSortDir === "asc" ? "ascending" : "descending";
				th.setAttribute("aria-sort", ariaSort);
				const nextDir = currentSortDir === "asc" ? "descending" : "ascending";
				btn.title = `Sort by ${label} (${nextDir})`;
			} else {
				th.setAttribute("aria-sort", "none");
				const defaultDir = col === "size" ? "descending" : "ascending";
				btn.title = `Sort by ${label} (${defaultDir})`;
			}
		}
	}

	function sortRows(col: SortCol, dir: SortDir) {
		currentSortCol = col;
		currentSortDir = dir;
		const mult = dir === "asc" ? 1 : -1;

		rows.sort((a, b) => {
			let diff = 0;
			if (col === "name") {
				diff = (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
			} else if (col === "date") {
				diff = (a.dataset.start ?? "").localeCompare(b.dataset.start ?? "");
			} else if (col === "country") {
				diff = (a.dataset.country ?? "").localeCompare(b.dataset.country ?? "");
				if (diff === 0) {
					diff = (a.dataset.city ?? "").localeCompare(b.dataset.city ?? "");
				}
			} else if (col === "topic") {
				diff = (a.dataset.topics ?? "").localeCompare(b.dataset.topics ?? "");
			} else if (col === "size") {
				const aRank = parseInt(a.dataset.tierRank ?? "0", 10);
				const bRank = parseInt(b.dataset.tierRank ?? "0", 10);
				diff = aRank - bRank;
			}

			if (diff !== 0) return diff * mult;

			// Stable tie-breaker: date ascending, then name ascending
			const dateDiff = (a.dataset.start ?? "").localeCompare(b.dataset.start ?? "");
			if (dateDiff !== 0) return dateDiff;
			return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
		});

		tbody.append(...rows);
		updateHeaderState();
	}

	sortThs.forEach((th) => {
		th.addEventListener("click", () => {
			const btn = th.querySelector<HTMLButtonElement>(".sort-btn");
			if (!btn) return;
			const col = btn.dataset.col as SortCol;
			if (!col) return;
			let nextDir: SortDir;
			if (col === currentSortCol) {
				nextDir = currentSortDir === "asc" ? "desc" : "asc";
			} else {
				nextDir = col === "size" ? "desc" : "asc";
			}
			sortRows(col, nextDir);
		});
	});

	search.addEventListener("input", applyFilters);
	topicTags.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-tag");
		if (!btn) return;
		topicTags.querySelectorAll(".filter-tag").forEach((b) => b.classList.remove("active"));
		btn.classList.add("active");
		activeTopic = btn.dataset.topic ?? "all";
		applyFilters();
	});
	tierTags.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-tag");
		if (!btn) return;
		tierTags.querySelectorAll(".filter-tag").forEach((b) => b.classList.remove("active"));
		btn.classList.add("active");
		activeTier = btn.dataset.tier ?? "all";
		applyFilters();
	});
	whenTags.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-tag");
		if (!btn) return;
		whenTags.querySelectorAll(".filter-tag").forEach((b) => b.classList.remove("active"));
		btn.classList.add("active");
		activeWhen = btn.dataset.when ?? "all";
		applyFilters();
	});
	resetAllBtn.addEventListener("click", () => {
		activeTopic = "all";
		activeTier = "all";
		activeWhen = "all";
		search.value = "";
		document.querySelectorAll("#topic-tags .filter-tag, #tier-tags .filter-tag, #when-tags .filter-tag").forEach((b) => {
			const el = b as HTMLElement;
			b.classList.toggle("active", el.dataset.topic === "all" || el.dataset.tier === "all" || el.dataset.when === "all");
		});
		applyFilters();
	});

	function csvCell(value: string) {
		// RFC 4180: quote anything containing a comma, quote or newline, doubling inner quotes
		return /[",\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
	}

	document.getElementById("csv-btn")?.addEventListener("click", () => {
		const header = ["Event", "Start", "End", "City", "Country", "Topics", "Size", "URL"];
		const visibleRows = rows
			.filter((r) => !r.hidden)
			.map((r) => JSON.parse(r.dataset.csv ?? "[]") as string[]);
		const csv = [header, ...visibleRows].map((cells) => cells.map(csvCell).join(",")).join("\r\n");
		const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8" });
		const url = URL.createObjectURL(blob);
		const a = document.createElement("a");
		a.href = url;
		a.download = "tech-events.csv";
		document.body.appendChild(a);
		a.click();
		a.remove();
		URL.revokeObjectURL(url);
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.page-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 20px;
		flex-wrap: wrap;
		margin-bottom: 20px;
	}
	h1 {
		margin: 0 0 4px;
		font-size: 32px;
		font-weight: 700;
		line-height: 1.15;
	}
	.sub {
		color: var(--text-dim);
		margin: 0;
		font-size: 16.5px;
	}
	.head-actions {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.filter-panel {
		padding: 16px 18px;
		margin-bottom: 20px;
	}
	.search-bar-row {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 14px;
	}
	.search-input {
		flex: 1 1 280px;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font);
		font-size: 16px;
		padding: 9px 12px;
		border-radius: 5px;
		outline: none;
	}
	.search-input::placeholder {
		color: var(--text-dim);
	}
	.search-input:focus {
		border-color: var(--accent);
	}
	.count-box {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.count-pill {
		font-family: var(--font);
		font-size: 13px;
		font-weight: 700;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 6px 11px;
		border-radius: 4px;
		white-space: nowrap;
	}
	.reset-link {
		background: none;
		border: none;
		color: var(--accent);
		font-family: var(--font);
		font-size: 12.5px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		cursor: pointer;
		padding: 4px;
	}
	.filter-groups {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.f-group-split {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
	}
	.f-group {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}
	.f-label {
		font-family: var(--font);
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-dim);
		min-width: 52px;
	}
	.filter-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
	}
	.filter-tag {
		background: var(--bg);
	}
	.empty {
		color: var(--text-dim);
		font-family: var(--font);
		padding: 28px 0;
		text-align: center;
	}
	.table-wrap {
		width: 100%;
		max-inline-size: 100%;
		overflow: auto;
		container-type: inline-size;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg);
	}
	table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 16px;
		--label-date: "Dates";
		--label-loc: "Location";
		--label-topic: "Topics";
		--label-size: "Size";
	}
	thead {
		position: sticky;
		inset-block-start: 0;
		z-index: 2;
		background: var(--surface);
	}
	th, td {
		text-align: left;
		padding: 11px 14px;
		border-bottom: 1px solid var(--border);
		vertical-align: middle;
	}
	tbody tr:last-child th,
	tbody tr:last-child td {
		border-bottom: none;
	}
	tbody tr:hover {
		background: var(--surface);
	}
	thead th {
		color: var(--text-dim);
		font-weight: 700;
		font-size: 12.5px;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		font-family: var(--font);
		background: var(--surface);
	}
	thead th[scope="col"] {
		cursor: pointer;
		user-select: none;
		transition: color 0.15s ease;
	}
	thead th[scope="col"]:hover {
		color: var(--text);
	}
	tbody th {
		font-weight: 700;
		font-family: var(--font);
		background: var(--bg);
	}
	tbody tr:hover th {
		background: var(--surface);
	}
	.sort-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		font: inherit;
		color: inherit;
		text-transform: inherit;
