---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { TOPICS, TIERS } from "../../lib/topics";
import events from "../../data/events.json";

const sorted = [...events].sort((a, b) => a.start.localeCompare(b.start));

function ymd(s: string) {
	return s.replace(/-/g, "");
}
function addDay(s: string) {
	const d = new Date(s + "T00:00:00Z");
	d.setUTCDate(d.getUTCDate() + 1);
	return d.toISOString().slice(0, 10);
}
function gcalUrl(ev: (typeof events)[number]) {
	const params = new URLSearchParams({
		action: "TEMPLATE",
		text: ev.name,
		dates: `${ymd(ev.start)}/${ymd(addDay(ev.end))}`,
		details: ev.url || `https://techeventsmap.com/events/${ev.slug}`,
		location: `${ev.city}, ${ev.country}`,
	});
	return `https://calendar.google.com/calendar/render?${params.toString()}`;
}

function fmtDate(s: string, e: string) {
	const opts: Intl.DateTimeFormatOptions = { month: "short", day: "numeric", year: "numeric" };
	const sd = new Date(s + "T00:00:00");
	const ed = new Date(e + "T00:00:00");
	const sStr = sd.toLocaleDateString("en-GB", { month: "short", day: "numeric" });
	if (s === e) return sd.toLocaleDateString("en-GB", opts);
	const eStr = ed.toLocaleDateString("en-GB", opts);
	return `${sStr} – ${eStr}`;
}
---
<Layout title="All events — Tech Events Map" description="Open source directory of tech, startup, AI and fintech events worldwide, listed by date.">
	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "ItemList",
		itemListElement: sorted.slice(0, 50).map((ev, i) => ({
			"@type": "ListItem",
			position: i + 1,
			url: `https://techeventsmap.com/events/${ev.slug}`,
			name: ev.name,
		})),
	})} />
	<SiteHeader />
	<div class="wrap">
		<div class="page-head">
			<h1>All events</h1>
			<p class="sub">Open source directory of tech, startup, AI and fintech conferences worldwide.</p>
			<div class="head-links">
				<a href="https://calendar.google.com/calendar/render?cid=https://techeventsmap.com/events.ics" target="_blank" rel="noopener">Subscribe (Google Calendar)</a>
				<span>·</span>
				<a href="/events.ics">Subscribe (Apple / Outlook)</a>
				<span>·</span>
				<button id="csv-btn" type="button">Export CSV</button>
				<span>·</span>
				<a href="https://github.com/CaptainDarkHeart/eventmap" target="_blank" rel="noopener">GitHub</a>
			</div>
		</div>
		<div class="controls">
			<input id="search" class="search-input" type="text" placeholder="Search events, cities, countries..." autocomplete="off" />
			<div class="filter-tags" id="tier-tags">
				<button class="filter-tag active" data-tier="all">All</button>
				<button class="filter-tag" data-tier="mega">Mega</button>
				<button class="filter-tag" data-tier="major">Major</button>
				<button class="filter-tag" data-tier="notable">Notable</button>
			</div>
		</div>
		<p id="empty" class="empty" hidden>No events match these filters.</p>
		<div class="table-wrap">
			<table id="events-table">
				<thead>
					<tr>
						<th scope="col" aria-sort="none">
							<button type="button" class="sort-btn" data-col="name" title="Sort by Event (ascending)">
								<span class="sort-label">Event</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th scope="col" aria-sort="ascending">
							<button type="button" class="sort-btn" data-col="date" title="Sort by Dates (descending)">
								<span class="sort-label">Dates</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th scope="col" aria-sort="none">
							<button type="button" class="sort-btn" data-col="country" title="Sort by Country (ascending)">
								<span class="sort-label">Location</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th scope="col" aria-sort="none">
							<button type="button" class="sort-btn" data-col="topic" title="Sort by Topic (ascending)">
								<span class="sort-label">Topic</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th scope="col" aria-sort="none">
							<button type="button" class="sort-btn" data-col="size" title="Sort by Size (descending)">
								<span class="sort-label">Size</span>
								<svg class="sort-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path class="sort-arrow-up" d="M4 1.5L7.5 5.5H0.5L4 1.5Z" fill="currentColor" />
									<path class="sort-arrow-down" d="M4 10.5L0.5 6.5H7.5L4 10.5Z" fill="currentColor" />
								</svg>
							</button>
						</th>
						<th class="cal-col"></th>
					</tr>
				</thead>
				<tbody>
					{sorted.map((ev) => (
						<tr
							data-name={ev.name.toLowerCase()}
							data-start={ev.start}
							data-city={ev.city.toLowerCase()}
							data-country={ev.country.toLowerCase()}
							data-topics={ev.topics.map((t) => TOPICS[t]?.label ?? t).join(", ").toLowerCase()}
							data-tier={ev.tier}
							data-tier-rank={ev.tier === "mega" ? 3 : ev.tier === "major" ? 2 : 1}
							data-csv={[ev.name, ev.start, ev.end, ev.city, ev.country, ev.topics.map((t) => TOPICS[t]?.label ?? t).join("; "), TIERS[ev.tier], ev.url].join("\t")}
						>
							<td><a href={`/events/${ev.slug}`}>{ev.name}</a></td>
							<td>{fmtDate(ev.start, ev.end)}</td>
							<td>{ev.city}, {ev.country}</td>
							<td>{ev.topics.map((t) => TOPICS[t]?.label ?? t).join(", ")}</td>
							<td class={`tier-${ev.tier}`}>{TIERS[ev.tier]}</td>
							<td class="cal-col">
								<a class="cal-link" href={gcalUrl(ev)} target="_blank" rel="noopener" title={`Add ${ev.name} to Google Calendar`}>Google</a>
								<a class="cal-link" href={`/events/${ev.slug}.ics`} title={`Download ${ev.name} for Apple / Outlook`}>Apple/Outlook</a>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</Layout>

<script>
	type SortCol = "name" | "date" | "country" | "topic" | "size";
	type SortDir = "asc" | "desc";

	const search = document.getElementById("search") as HTMLInputElement;
	const tbody = document.querySelector("#events-table tbody") as HTMLTableSectionElement;
	const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("#events-table tbody tr"));
	const empty = document.getElementById("empty") as HTMLElement;
	const tierTags = document.getElementById("tier-tags") as HTMLElement;
	const sortThs = Array.from(document.querySelectorAll<HTMLTableCellElement>("#events-table thead th[scope='col']"));

	let activeTier = "all";
	let currentSortCol: SortCol = "date";
	let currentSortDir: SortDir = "asc";

	function applyFilters() {
		const q = search.value.trim().toLowerCase();
		let visibleCount = 0;
		for (const row of rows) {
			const tierOk = activeTier === "all" || row.dataset.tier === activeTier;
			const searchOk =
				!q ||
				(row.dataset.name ?? "").includes(q) ||
				(row.dataset.city ?? "").includes(q) ||
				(row.dataset.country ?? "").includes(q);
			const visible = tierOk && searchOk;
			row.hidden = !visible;
			if (visible) visibleCount++;
		}
		empty.hidden = visibleCount > 0;
	}

	function updateHeaderState() {
		for (const th of sortThs) {
			const btn = th.querySelector<HTMLButtonElement>(".sort-btn");
			if (!btn) continue;
			const col = btn.dataset.col as SortCol;
			const label = btn.querySelector(".sort-label")?.textContent ?? col;
			if (col === currentSortCol) {
				const ariaSort = currentSortDir === "asc" ? "ascending" : "descending";
				th.setAttribute("aria-sort", ariaSort);
				const nextDir = currentSortDir === "asc" ? "descending" : "ascending";
				btn.title = `Sort by ${label} (${nextDir})`;
			} else {
				th.setAttribute("aria-sort", "none");
				const defaultDir = col === "size" ? "descending" : "ascending";
				btn.title = `Sort by ${label} (${defaultDir})`;
			}
		}
	}

	function sortRows(col: SortCol, dir: SortDir) {
		currentSortCol = col;
		currentSortDir = dir;
		const mult = dir === "asc" ? 1 : -1;

		rows.sort((a, b) => {
			let diff = 0;
			if (col === "name") {
				diff = (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
			} else if (col === "date") {
				diff = (a.dataset.start ?? "").localeCompare(b.dataset.start ?? "");
			} else if (col === "country") {
				diff = (a.dataset.country ?? "").localeCompare(b.dataset.country ?? "");
				if (diff === 0) {
					diff = (a.dataset.city ?? "").localeCompare(b.dataset.city ?? "");
				}
			} else if (col === "topic") {
				diff = (a.dataset.topics ?? "").localeCompare(b.dataset.topics ?? "");
			} else if (col === "size") {
				const aRank = parseInt(a.dataset.tierRank ?? "0", 10);
				const bRank = parseInt(b.dataset.tierRank ?? "0", 10);
				diff = aRank - bRank;
			}

			if (diff !== 0) return diff * mult;

			// Stable tie-breaker: date ascending, then name ascending
			const dateDiff = (a.dataset.start ?? "").localeCompare(b.dataset.start ?? "");
			if (dateDiff !== 0) return dateDiff;
			return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
		});

		tbody.append(...rows);
		updateHeaderState();
	}

	sortThs.forEach((th) => {
		th.addEventListener("click", () => {
			const btn = th.querySelector<HTMLButtonElement>(".sort-btn");
			if (!btn) return;
			const col = btn.dataset.col as SortCol;
			if (!col) return;
			let nextDir: SortDir;
			if (col === currentSortCol) {
				nextDir = currentSortDir === "asc" ? "desc" : "asc";
			} else {
				nextDir = col === "size" ? "desc" : "asc";
			}
			sortRows(col, nextDir);
		});
	});

	search.addEventListener("input", applyFilters);
	tierTags.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-tag");
		if (!btn) return;
		tierTags.querySelectorAll(".filter-tag").forEach((b) => b.classList.remove("active"));
		btn.classList.add("active");
		activeTier = btn.dataset.tier ?? "all";
		applyFilters();
	});

	document.getElementById("csv-btn")?.addEventListener("click", () => {
		const header = ["Event", "Start", "End", "City", "Country", "Topics", "Size", "URL"].join("\t");
		const visibleRows = rows.filter((r) => !r.hidden).map((r) => r.dataset.csv ?? "");
		const csv = [header, ...visibleRows].join("\n");
		const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
		const url = URL.createObjectURL(blob);
		const a = document.createElement("a");
		a.href = url;
		a.download = "tech-events.csv";
		a.click();
		URL.revokeObjectURL(url);
	});
</script>

<style>
	.wrap {
		max-width: 960px;
		margin: 0 auto;
		padding: 24px 16px 60px;
	}
	.page-head { margin-bottom: 18px; }
	h1 { margin: 0 0 4px; font-size: 30px; font-weight: 700; }
	.sub { color: var(--text-dim); margin: 0 0 8px; font-size: 17px; font-family: var(--font); }
	.head-links { display: flex; align-items: center; gap: 10px; font-family: var(--font); font-size: 17px; color: var(--text-dim); }
	.head-links a { color: var(--accent); text-decoration: none; }
	.head-links button {
		background: none;
		border: none;
		color: var(--accent);
		font-family: var(--font);
		font-size: 17px;
		cursor: pointer;
		padding: 0;
	}
	.controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 14px; }
	.search-input {
		flex: 1 1 220px;
		background: var(--surface-2);
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font);
		font-size: 16px;
		padding: 8px 10px;
		border-radius: 4px;
		outline: none;
	}
	.search-input::placeholder { color: var(--text-dim); }
	.search-input:focus { border-color: var(--accent); }
	.filter-tags { display: flex; flex-wrap: wrap; gap: 5px; }
	.filter-tag {
		font-family: var(--font);
		font-size: 14px;
		padding: 6px 10px;
		border-radius: 3px;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text-dim);
		cursor: pointer;
	}
	.filter-tag:hover { border-color: var(--text-dim); color: var(--text); }
	.filter-tag.active { background: var(--accent); border-color: var(--accent); color: var(--bg); }
	.empty { color: var(--text-dim); font-family: var(--mono); padding: 20px 0; }
	.table-wrap {
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}
	table { width: 100%; border-collapse: collapse; font-size: 17px; }
	th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--border); }
	th { color: var(--text-dim); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--mono); }
	th[scope="col"] {
		cursor: pointer;
		user-select: none;
		transition: color 0.15s ease;
	}
	th[scope="col"]:hover {
		color: var(--text);
	}
	.sort-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		font: inherit;
		color: inherit;
		text-transform: inherit;
		letter-spacing: inherit;
		cursor: pointer;
		user-select: none;
		white-space: nowrap;
		transition: color 0.15s ease;
	}
	.sort-btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 2px;
	}
	th[aria-sort="ascending"],
	th[aria-sort="descending"] {
		color: var(--text);
	}
	th[aria-sort="ascending"] .sort-btn,
	th[aria-sort="descending"] .sort-btn {
		color: var(--text);
	}
	.sort-icon {
		display: inline-block;
		width: 8px;
		height: 12px;
		flex-shrink: 0;
		vertical-align: middle;
	}
	.sort-arrow-up,
	.sort-arrow-down {
		transition: opacity 0.15s ease, fill 0.15s ease;
	}
	th[aria-sort="none"] .sort-arrow-up,
	th[aria-sort="none"] .sort-arrow-down {
		opacity: 0.25;
	}
	th[aria-sort="none"]:hover .sort-arrow-up,
	th[aria-sort="none"]:hover .sort-arrow-down {
		opacity: 0.6;
	}
	th[aria-sort="ascending"] .sort-arrow-up {
		opacity: 1;
		fill: var(--accent);
	}
	th[aria-sort="ascending"] .sort-arrow-down {
		opacity: 0.15;
	}
	th[aria-sort="descending"] .sort-arrow-down {
		opacity: 1;
		fill: var(--accent);
	}
	th[aria-sort="descending"] .sort-arrow-up {
		opacity: 0.15;
	}
	td { font-family: var(--font); }
	a { text-decoration: none; color: var(--text); }
	td a:hover { color: var(--accent); }
	.tier-mega, .tier-major, .tier-notable { font-family: var(--mono); font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; }
	.cal-col { white-space: nowrap; text-align: right; }
	.cal-link { color: var(--accent) !important; font-family: var(--font); font-size: 15px; }
	.cal-link:hover { text-decoration: underline; }
	.cal-link + .cal-link { margin-left: 10px; }
	@media (max-width: 640px) {
		.cal-col { display: none; }
	}
</style>
