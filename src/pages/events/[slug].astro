---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { TOPICS, TIERS } from "../../lib/topics";
import { outboundUrl } from "../../lib/utm";
import events from "../../data/events.json";
import { groupsFor, slugify, canonCountry } from "../../lib/areas.mjs";

export function getStaticPaths() {
	return events.map((ev) => ({ params: { slug: ev.slug }, props: { ev } }));
}

const { ev } = Astro.props;
const cityHref = groupsFor("cities").some((g) => g.key === `${ev.city}|${canonCountry(ev.country)}`) ? `/cities/${slugify(ev.city)}/` : null;
const countryHref = groupsFor("countries").some((g) => g.key === canonCountry(ev.country)) ? `/countries/${slugify(canonCountry(ev.country))}/` : null;

function fmtDate(s: string, e: string) {
	const opts: Intl.DateTimeFormatOptions = { month: "long", day: "numeric", year: "numeric" };
	const sd = new Date(s + "T00:00:00");
	const ed = new Date(e + "T00:00:00");
	if (s === e) return sd.toLocaleDateString("en-GB", opts);
	return `${sd.toLocaleDateString("en-GB", { month: "long", day: "numeric" })} – ${ed.toLocaleDateString("en-GB", opts)}`;
}

function ymd(s: string) {
	return s.replace(/-/g, "");
}
function addDay(s: string) {
	const d = new Date(s + "T00:00:00Z");
	d.setUTCDate(d.getUTCDate() + 1);
	return d.toISOString().slice(0, 10);
}
const topicLabels = ev.topics.map((t: string) => TOPICS[t]?.label ?? t);
const dayMs = 86400000;
const startMs = new Date(ev.start + "T00:00:00Z").getTime();
const others = events.filter((e) => e.slug !== ev.slug);
const byStart = (a: any, b: any) => a.start.localeCompare(b.start);
const sameCity = others.filter((e) => e.city === ev.city && canonCountry(e.country) === canonCountry(ev.country)).sort(byStart).slice(0, 6);
const sameWeeks = others
	.filter((e) => Math.abs(new Date(e.start + "T00:00:00Z").getTime() - startMs) <= 14 * dayMs && !sameCity.includes(e))
	.sort((a, b) => Math.abs(new Date(a.start + "T00:00:00Z").getTime() - startMs) - Math.abs(new Date(b.start + "T00:00:00Z").getTime() - startMs))
	.slice(0, 6);
const sameTopic = others
	.filter((e) => e.topics.some((t: string) => ev.topics.includes(t)) && !sameCity.includes(e) && !sameWeeks.includes(e))
	.sort((a, b) => Math.abs(new Date(a.start + "T00:00:00Z").getTime() - startMs) - Math.abs(new Date(b.start + "T00:00:00Z").getTime() - startMs))
	.slice(0, 6);
const related = [
	sameCity.length ? { title: `More events in ${ev.city}`, list: sameCity } : null,
	sameWeeks.length ? { title: "Around the same dates", list: sameWeeks } : null,
	sameTopic.length ? { title: `More ${topicLabels[0]} events`, list: sameTopic } : null,
].filter(Boolean) as { title: string; list: any[] }[];
const sizeText: Record<string, string> = {
	mega: "one of the largest tech events on the map, with 10,000 or more attendees expected",
	major: "a major event on the map",
	notable: "a notable event on the map",
};
const faq = [
	{ q: `When is ${ev.name}?`, a: `${ev.name} runs ${fmtDate(ev.start, ev.end)}. Dates can shift year to year, so confirm on the official site before booking travel.` },
	{ q: `Where is ${ev.name}?`, a: `${ev.name} takes place in ${ev.city}, ${ev.country}.` },
	{ q: `What topics does ${ev.name} cover?`, a: `It is listed under ${topicLabels.join(", ")}.` },
];
const year = String(new Date(ev.start + "T00:00:00Z").getUTCFullYear());
const gcalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(ev.name)}&dates=${ymd(ev.start)}/${ymd(addDay(ev.end))}&details=${encodeURIComponent(ev.url || `https://techeventsmap.com/events/${ev.slug}/`)}&location=${encodeURIComponent(`${ev.city}, ${ev.country}`)}`;
---
<Layout title={`${ev.name.includes(year) ? ev.name : `${ev.name} ${year}`}: dates, location | Tech Events Map`} description={`${ev.name} runs ${fmtDate(ev.start, ev.end)} in ${ev.city}, ${ev.country}. ${topicLabels.join(", ")} event. Add it to your calendar and see other events nearby.`} jsonLd={{ "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }} breadcrumbs={[{ name: "Home", path: "/" }, { name: "All events", path: "/events/" }, { name: ev.name, path: `/events/${ev.slug}/` }]}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Event",
		name: ev.name,
		description: `${ev.name}, ${fmtDate(ev.start, ev.end)}, ${ev.city}, ${ev.country}. ${ev.topics.map((t: string) => TOPICS[t]?.label ?? t).join(", ")} event.`,
		image: ["https://techeventsmap.com/og-image.png"],
		organizer: { "@type": "Organization", name: ev.organizer || ev.name, url: ev.url || `https://techeventsmap.com/events/${ev.slug}/` },
		...(ev.performers?.length ? { performer: ev.performers.map((n: string) => ({ "@type": "Person", name: n })) } : {}),
		...(ev.offer ? { offers: { "@type": "Offer", url: ev.offer.url || ev.url, price: ev.offer.price, priceCurrency: ev.offer.currency || "USD", availability: "https://schema.org/InStock" } } : {}),
		startDate: ev.start,
		endDate: ev.end,
		eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
		eventStatus: "https://schema.org/EventScheduled",
		location: {
			"@type": "Place",
			name: `${ev.city}, ${ev.country}`,
			address: { "@type": "PostalAddress", addressLocality: ev.city, addressCountry: ev.country },
			geo: { "@type": "GeoCoordinates", latitude: ev.lat, longitude: ev.lng },
		},
		url: ev.url || `https://techeventsmap.com/events/${ev.slug}/`,
	})} />
	<SiteHeader />
	<div class="wrap">
		<a class="back" href="/events/">← All events</a>
		<h1>{ev.name}</h1>
		<div class="meta">
			<span>{fmtDate(ev.start, ev.end)}</span>
			<span>·</span>
			<span>{cityHref ? <a href={cityHref}>{ev.city}</a> : ev.city}, {countryHref ? <a href={countryHref}>{ev.country}</a> : ev.country}</span>
			<span>·</span>
			<span class={`tier-${ev.tier}`}>{TIERS[ev.tier]}</span>
		</div>
		<div class="topics">
			{ev.topics.map((t: string) => <span class="pill">{TOPICS[t]?.label ?? t}</span>)}
		</div>
		<p class="summary">{ev.name} takes place {fmtDate(ev.start, ev.end)} in {cityHref ? <a href={cityHref}>{ev.city}</a> : ev.city}, {ev.country}. It is {sizeText[ev.tier] ?? "listed on the map"}, covering {topicLabels.join(", ")}.</p>
		<div class="cal-actions">
			<a class="cal-btn" href={gcalUrl} target="_blank" rel="noopener">+ Google Calendar</a>
			<a class="cal-btn" href={`/events/${ev.slug}.ics`} rel="nofollow">Download .ics (Apple / Outlook)</a>
		</div>
		<p class="source">Date sourced from {ev.source}. Dates can shift year to year, always confirm on the official site before booking travel. Tech Events Map is open source. Spot an error? <a href="https://github.com/CaptainDarkHeart/eventmap" target="_blank" rel="noopener">Edit on GitHub</a> or <a href="/contact/">contact me</a>.</p>
		<section class="faq">
			<h2>Quick answers</h2>
			{faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
		</section>
		{related.map((r) => (
			<section class="related">
				<h2>{r.title}</h2>
				<ul>
					{r.list.map((e) => <li><a href={`/events/${e.slug}/`}>{e.name}</a> <span>{fmtDate(e.start, e.end)}, {e.city}</span></li>)}
				</ul>
			</section>
		))}
		<div class="bottom-links">
			{ev.url && <a class="map-link" href={outboundUrl(ev.url, ev.slug)} target="_blank" rel="noopener">View event →</a>}
			<a class="map-link view-map" href={`/#${ev.slug}`}>View on map →</a>
		</div>
	</div>
</Layout>

<style>
	.wrap { max-width: 640px; margin: 0 auto; padding: 24px 16px 60px; }
	.back { text-decoration: none; color: var(--text-dim); font-size: 16px; font-family: var(--mono); }
	h1 { margin: 14px 0 6px; font-size: 32.5px; font-weight: 700; }
	.meta { color: var(--text-dim); font-size: 16px; font-family: var(--mono); display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
	.topics { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 18px; }
	.bottom-links { display: flex; align-items: center; gap: 16px; }
	.bottom-links .view-map { margin-left: auto; }
	.map-link { color: var(--accent); text-decoration: none; font-size: 17.5px; }
	.cal-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
	.cal-btn {
		font-family: var(--mono);
		font-size: 14.5px;
		padding: 8px 14px;
		border-radius: 4px;
		border: 1px solid var(--border);
		color: var(--text);
		text-decoration: none;
	}
	.cal-btn:hover { border-color: var(--accent); color: var(--accent); }
	.source { color: var(--text-dim); font-size: 15px; font-family: var(--mono); margin-top: 20px; }
	.source a { color: var(--accent); }
	.summary { font-size: 18px; line-height: 1.5; margin: 0 0 8px; }
	.summary a { color: var(--accent); }
	.faq, .related { margin-top: 28px; }
	.faq h2, .related h2 { font-size: 20px; margin: 0 0 10px; }
	.faq h3 { font-size: 16px; margin: 12px 0 2px; }
	.faq p { margin: 0; color: var(--text-dim); font-size: 16px; line-height: 1.5; }
	.related ul { list-style: none; padding: 0; margin: 0; }
	.related li { padding: 5px 0; font-size: 16px; }
	.related li a { color: var(--accent); text-decoration: none; }
	.related li span { color: var(--text-dim); font-family: var(--mono); font-size: 13.5px; margin-left: 6px; }
	.bottom-links { margin-top: 28px; }
</style>
