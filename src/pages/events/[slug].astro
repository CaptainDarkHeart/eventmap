---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { TOPICS, TIERS } from "../../lib/topics";
import { outboundUrl } from "../../lib/utm";
import events from "../../data/events.json";
import { groupsFor, slugify, canonCountry } from "../../lib/areas.mjs";

export function getStaticPaths() {
	return events.map((ev) => ({ params: { slug: ev.slug }, props: { ev } }));
}

const { ev } = Astro.props;
const cityHref = groupsFor("cities").some((g) => g.key === `${ev.city}|${canonCountry(ev.country)}`) ? `/cities/${slugify(ev.city)}/` : null;
const countryHref = groupsFor("countries").some((g) => g.key === canonCountry(ev.country)) ? `/countries/${slugify(canonCountry(ev.country))}/` : null;

function fmtDate(s: string, e: string) {
	const opts: Intl.DateTimeFormatOptions = { month: "long", day: "numeric", year: "numeric" };
	const sd = new Date(s + "T00:00:00");
	const ed = new Date(e + "T00:00:00");
	if (s === e) return sd.toLocaleDateString("en-GB", opts);
	return `${sd.toLocaleDateString("en-GB", { month: "long", day: "numeric" })} - ${ed.toLocaleDateString("en-GB", opts)}`;
}

function fmtShortDate(s: string, e: string) {
	const opts: Intl.DateTimeFormatOptions = { month: "short", day: "numeric", year: "numeric" };
	const sd = new Date(s + "T00:00:00");
	const ed = new Date(e + "T00:00:00");
	if (s === e) return sd.toLocaleDateString("en-GB", opts);
	return `${sd.toLocaleDateString("en-GB", { month: "short", day: "numeric" })} - ${ed.toLocaleDateString("en-GB", opts)}`;
}

function ymd(s: string) {
	return s.replace(/-/g, "");
}
function addDay(s: string) {
	const d = new Date(s + "T00:00:00Z");
	d.setUTCDate(d.getUTCDate() + 1);
	return d.toISOString().slice(0, 10);
}
const topicLabels = ev.topics.map((t: string) => TOPICS[t]?.label ?? t);
const dayMs = 86400000;
const startMs = new Date(ev.start + "T00:00:00Z").getTime();
const others = events.filter((e) => e.slug !== ev.slug);
const byStart = (a: any, b: any) => a.start.localeCompare(b.start);
const sameCity = others.filter((e) => e.city === ev.city && canonCountry(e.country) === canonCountry(ev.country)).sort(byStart).slice(0, 6);
const sameWeeks = others
	.filter((e) => Math.abs(new Date(e.start + "T00:00:00Z").getTime() - startMs) <= 14 * dayMs && !sameCity.includes(e))
	.sort((a, b) => Math.abs(new Date(a.start + "T00:00:00Z").getTime() - startMs) - Math.abs(new Date(b.start + "T00:00:00Z").getTime() - startMs))
	.slice(0, 6);
const sameTopic = others
	.filter((e) => e.topics.some((t: string) => ev.topics.includes(t)) && !sameCity.includes(e) && !sameWeeks.includes(e))
	.sort((a, b) => Math.abs(new Date(a.start + "T00:00:00Z").getTime() - startMs) - Math.abs(new Date(b.start + "T00:00:00Z").getTime() - startMs))
	.slice(0, 6);
const related = [
	sameCity.length ? { title: `More events in ${ev.city}`, list: sameCity } : null,
	sameWeeks.length ? { title: "Around the same dates", list: sameWeeks } : null,
	sameTopic.length ? { title: `More ${topicLabels[0]} events`, list: sameTopic } : null,
].filter(Boolean) as { title: string; list: any[] }[];
const sizeText: Record<string, string> = {
	mega: "one of the largest tech events on the map, with 10,000 or more attendees expected",
	major: "a major event on the map",
	notable: "a notable event on the map",
};
const faq = [
	{ q: `When is ${ev.name}?`, a: `${ev.name} runs ${fmtDate(ev.start, ev.end)}. Dates can shift year to year, so confirm on the official site before booking travel.` },
	{ q: `Where is ${ev.name}?`, a: `${ev.name} takes place in ${ev.city}, ${ev.country}.` },
	{ q: `What topics does ${ev.name} cover?`, a: `It is listed under ${topicLabels.join(", ")}.` },
];
const year = String(new Date(ev.start + "T00:00:00Z").getUTCFullYear());
const gcalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(ev.name)}&dates=${ymd(ev.start)}/${ymd(addDay(ev.end))}&details=${encodeURIComponent(ev.url || `https://techeventsmap.com/events/${ev.slug}/`)}&location=${encodeURIComponent(`${ev.city}, ${ev.country}`)}`;
---
<Layout title={`${ev.name.includes(year) ? ev.name : `${ev.name} ${year}`}: dates, location | Tech Events Map`} description={`${ev.name} runs ${fmtDate(ev.start, ev.end)} in ${ev.city}, ${ev.country}. ${topicLabels.join(", ")} event. Add it to your calendar and see other events nearby.`} jsonLd={{ "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }} breadcrumbs={[{ name: "Home", path: "/" }, { name: "All events", path: "/events/" }, { name: ev.name, path: `/events/${ev.slug}/` }]}>
	<script is:inline type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Event",
		name: ev.name,
		description: `${ev.name}, ${fmtDate(ev.start, ev.end)}, ${ev.city}, ${ev.country}. ${ev.topics.map((t: string) => TOPICS[t]?.label ?? t).join(", ")} event.`,
		image: ["https://techeventsmap.com/og-image.png"],
		organizer: { "@type": "Organization", name: ev.organizer || ev.name, url: ev.url || `https://techeventsmap.com/events/${ev.slug}/` },
		...(ev.performers?.length ? { performer: ev.performers.map((n: string) => ({ "@type": "Person", name: n })) } : {}),
		...(ev.offer ? { offers: { "@type": "Offer", url: ev.offer.url || ev.url, price: ev.offer.price, priceCurrency: ev.offer.currency || "USD", availability: "https://schema.org/InStock" } } : {}),
		startDate: ev.start,
		endDate: ev.end,
		eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
		eventStatus: "https://schema.org/EventScheduled",
		location: {
			"@type": "Place",
			name: `${ev.city}, ${ev.country}`,
			address: { "@type": "PostalAddress", addressLocality: ev.city, addressCountry: ev.country },
			geo: { "@type": "GeoCoordinates", latitude: ev.lat, longitude: ev.lng },
		},
		url: ev.url || `https://techeventsmap.com/events/${ev.slug}/`,
	})} />
	<SiteHeader />
	<main class="wrap-wide">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span>/</span><a href="/events/">All events</a><span>/</span>{ev.name}
		</nav>

		<div class="dossier-grid">
			<div class="dossier-main">
				<div class="title-block">
					<div class="topics">
						{ev.topics.map((t: string) => (
							<a class="pill" href={`/topics/${slugify(TOPICS[t]?.label ?? t)}/`}>
								<span class="dot" style={`background:${TOPICS[t]?.color ?? "#999"}`}></span>
								{TOPICS[t]?.label ?? t}
							</a>
						))}
						<span class={`pill tier-${ev.tier}`}>{TIERS[ev.tier]}</span>
					</div>
					<h1>{ev.name}</h1>
					<p class="summary">{ev.name} takes place {fmtDate(ev.start, ev.end)} in {cityHref ? <a href={cityHref}>{ev.city}</a> : ev.city}, {countryHref ? <a href={countryHref}>{ev.country}</a> : ev.country}. It is {sizeText[ev.tier] ?? "listed on the map"}, covering {topicLabels.join(", ")}.</p>
				</div>

				<div class="facts-grid card">
					<div class="fact">
						<span class="fact-label">Dates</span>
						<span class="fact-val">{fmtDate(ev.start, ev.end)}</span>
					</div>
					<div class="fact">
						<span class="fact-label">Location</span>
						<span class="fact-val">
							{cityHref ? <a href={cityHref}>{ev.city}</a> : ev.city}, {countryHref ? <a href={countryHref}>{ev.country}</a> : ev.country}
						</span>
					</div>
					<div class="fact">
						<span class="fact-label">Size Tier</span>
						<span class={`fact-val tier-${ev.tier}`}>{TIERS[ev.tier]}</span>
					</div>
					<div class="fact">
						<span class="fact-label">Coordinates</span>
						<span class="fact-val">{ev.lat.toFixed(4)}, {ev.lng.toFixed(4)}</span>
					</div>
					{ev.organizer && (
						<div class="fact">
							<span class="fact-label">Organiser</span>
							<span class="fact-val">{ev.organizer}</span>
						</div>
					)}
					{ev.offer && (
						<div class="fact">
							<span class="fact-label">Ticket Guide</span>
							<span class="fact-val">{ev.offer.currency || "USD"} {ev.offer.price}</span>
						</div>
					)}
				</div>

				<section class="faq-section">
					<h2>Quick answers</h2>
					<div class="faq-cards">
						{faq.map((f) => (
							<div class="faq-card card">
								<h3>{f.q}</h3>
								<p>{f.a}</p>
							</div>
						))}
					</div>
				</section>

				<p class="source-note">
					Date sourced from <strong>{ev.source}</strong>. Dates can shift year to year, always confirm on the official site before booking travel. Spot an error? <a href="/contact/">Contact me</a>.
				</p>
			</div>

			<aside class="dossier-side">
				<div class="action-card card">
					<span class="side-heading">Actions &amp; Links</span>
					<div class="action-stack">
						{ev.url && (
							<a class="btn btn-primary full-btn" href={outboundUrl(ev.url, ev.slug)} target="_blank" rel="noopener">
								Official Website &rarr;
							</a>
						)}
						<a class="btn full-btn" href={`/#${ev.slug}`}>
							View on Interactive Map &rarr;
						</a>
					</div>

					<hr class="divider" />

					<span class="side-heading">Add to Calendar</span>
					<div class="action-stack">
						<a class="btn full-btn" href={gcalUrl} target="_blank" rel="noopener">+ Google Calendar</a>
						<a class="btn full-btn" href={`/events/${ev.slug}.ics`} rel="nofollow">Download .ics (Apple / Outlook)</a>
					</div>

					<hr class="divider" />

					<span class="side-heading">Trip Planning</span>
					<p class="side-hint">Building a conference schedule around {ev.city}?</p>
					<a class="side-link" href="/plan/">Open Trip Planner &rarr;</a>
				</div>
			</aside>
		</div>

		{related.length > 0 && (
			<section class="related-wrap">
				<div class="related-grid">
					{related.map((r) => (
						<div class="related-col card">
							<h2>{r.title}</h2>
							<ul>
								{r.list.map((e) => (
									<li>
										<a href={`/events/${e.slug}/`}>{e.name}</a>
										<span>{fmtShortDate(e.start, e.end)} &middot; {e.city}</span>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</section>
		)}
	</main>
</Layout>

<style>
	.dossier-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 32px;
		align-items: start;
	}
	.title-block {
		margin-bottom: 24px;
	}
	.topics {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
		margin-bottom: 12px;
	}
	.topics a.pill {
		text-decoration: none;
	}
	.topics a.pill:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.topics .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
	}
	h1 {
		margin: 0 0 12px;
		font-size: 36px;
		font-weight: 700;
		line-height: 1.15;
	}
	.summary {
		font-size: 18px;
		line-height: 1.55;
		margin: 0;
		color: var(--text);
	}
	.summary a {
		color: var(--accent);
		text-decoration: none;
	}
	.summary a:hover {
		text-decoration: underline;
	}
	.facts-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px 24px;
		margin-bottom: 28px;
	}
	.fact {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.fact-label {
		font-family: var(--font);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--text-dim);
	}
	.fact-val {
		font-size: 16.5px;
		font-weight: 700;
	}
	.fact-val a {
		color: var(--accent);
		text-decoration: none;
	}
	.fact-val a:hover {
		text-decoration: underline;
	}
	.faq-section {
		margin-bottom: 24px;
	}
	.faq-section h2 {
		font-size: 20px;
		margin: 0 0 12px;
	}
	.faq-cards {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.faq-card {
		padding: 14px 16px;
	}
	.faq-card h3 {
		font-size: 16px;
		margin: 0 0 4px;
	}
	.faq-card p {
		margin: 0;
		color: var(--text-dim);
		font-size: 15.5px;
		line-height: 1.5;
	}
	.source-note {
		color: var(--text-dim);
		font-size: 13.5px;
		font-family: var(--font);
		margin: 0;
		line-height: 1.5;
	}
	.source-note a {
		color: var(--accent);
	}
	.dossier-side {
		position: sticky;
		top: 76px;
	}
	.action-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.side-heading {
		font-family: var(--font);
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-dim);
	}
	.action-stack {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.full-btn {
		width: 100%;
		justify-content: center;
		padding: 10px 14px;
	}
	.divider {
		border: none;
		border-top: 1px solid var(--border);
		margin: 6px 0;
	}
	.side-hint {
		margin: 0;
		font-size: 14.5px;
		color: var(--text-dim);
	}
	.side-link {
		font-family: var(--font);
		font-size: 13px;
		color: var(--accent);
		text-decoration: none;
		font-weight: 700;
	}
	.side-link:hover {
		text-decoration: underline;
	}
	.related-wrap {
		margin-top: 40px;
		padding-top: 32px;
		border-top: 1px solid var(--border);
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 20px;
	}
	.related-col h2 {
		font-size: 17px;
		margin: 0 0 12px;
		font-family: var(--font);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-dim);
	}
	.related-col ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.related-col li {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--border);
	}
	.related-col li:last-child {
		padding-bottom: 0;
		border-bottom: none;
	}
	.related-col li a {
		color: var(--text);
		font-weight: 700;
		font-size: 15.5px;
		text-decoration: none;
	}
	.related-col li a:hover {
		color: var(--accent);
	}
	.related-col li span {
		color: var(--text-dim);
		font-family: var(--font);
		font-size: 12.5px;
	}
	@media (max-width: 860px) {
		.dossier-grid {
			grid-template-columns: 1fr;
		}
		.dossier-side {
			position: static;
			order: -1;
		}
	}
	@media (max-width: 520px) {
		.facts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
