---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import events from "../data/events.json";

const sourceCount = new Set(events.map((e) => e.source)).size;
const sources = [
	{ name: "Dealroom", url: "https://dealroom.co/events/", desc: "Global startup & tech events" },
	{ name: "Techmeme", url: "https://www.techmeme.com/events", desc: "Major tech industry conferences" },
	{ name: "dev.events", url: "https://dev.events/", desc: "Developer & engineering conferences" },
	{ name: "Sesamers", url: "https://sesamers.com/events/", desc: "Tech, startup & industry tradeshows, mostly Europe" },
	{ name: "Black Unicorn PR", url: "https://www.blackunicornpr.com/", desc: "European & North American startup events" },
	{ name: "confs.tech", url: "https://confs.tech/", desc: "Open source, crowd-sourced developer & AI conferences" },
	{ name: "Tech.eu", url: "https://tech.eu/events", desc: "European tech and startup events" },
	{ name: "TechCrunch", url: "https://techcrunch.com/events/", desc: "Startup, VC & founder events" },
	{ name: "Ballou PR", url: "https://balloupr.com/events-2026/", desc: "European tech, cybersecurity & blockchain events" },
	{ name: "Gallium Ventures", url: "https://galliumventures.com/blog/", desc: "Flagship international AI, fintech & cybersecurity events" },
	{ name: "Qolaig", url: "https://www.qolaig.com/en/articles/tech-events-in-europe-2026-2027", desc: "Large European tech, marketing & fintech events" },
	{ name: "JapanConf", url: "https://japanconf.com/en/timeline/", desc: "Tech & startup conferences in Japan" },
	{ name: "FinTech Weekly", url: "https://www.fintechweekly.com/fintech-conferences/", desc: "Global fintech, payments & banking conferences" },
	{ name: "Vestbee", url: "https://www.vestbee.com/insights/articles/must-attend-startup-and-vc-events-in-2026", desc: "CEE and European VC, investor & founder events" },
	{ name: "Linux Foundation AI Calendar", url: "https://events.linuxfoundation.org/calendar/ai-conferences/", desc: "Industry & startup AI, agent and ML engineering conferences" },
	{ name: "StartupEvents.org", url: "https://startupevents.org/startup-events-calendar", desc: "Global startup conferences & founder events" },
	{ name: "Manual research", url: "", desc: "Individually verified against each event's official site" },
];
---
<Layout title="About | Tech Events Map" description="What Tech Events Map is, where the data comes from, and who built it." breadcrumbs={[{ name: "Home", path: "/" }, { name: "About", path: "/about/" }]}>
	<SiteHeader />
	<main class="wrap-wide">
		<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>About</nav>
		<div class="about-hero">
			<h1>About Tech Events Map</h1>
			<p class="lead">Tech Events Map is a free, open source interactive map of tech, startup, AI and fintech conferences worldwide. It pulls listings from several sources into one place, on a map, so you can see what's happening and where without trawling separate event calendars city by city.</p>
		</div>

		<div class="about-top-grid">
			<section class="builder-card card">
				<div class="builder-row">
					<div class="builder-text">
						<span class="sec-kicker">Who Built This</span>
						<h2>Dan Taylor</h2>
						<p>Tech Events Map was built by me, <a href="https://dantaylor.me" target="_blank" rel="noopener">Dan Taylor</a>. I do a bunch of things, but mostly web development, photography, and PR-related stuff.</p>
						<p>I built this map as an open source project in response to the wide variety of tech event listings that are scattered across dozens of separate sites. Each has its own format and there is no easy way to compare them. This map brings them together in one place so you can see at a glance where and when things are happening.</p>
					</div>
					<div class="builder-pin">
						<span class="pin-shape"><img src="/dan.jpg" alt="Dan Taylor" width="76" height="76" /></span>
						<p class="pin-name"><a href="https://dantaylor.me" target="_blank" rel="noopener">Dan Taylor</a><br /><span class="pin-role">Builder</span></p>
					</div>
				</div>
			</section>

			<section class="oss-card card">
				<span class="sec-kicker">Contributing &amp; Feedback</span>
				<h2>Suggest an Event or Fix</h2>
				<p>Every listing on Tech Events Map is verified against public event directories and each conference's official website. Concluded events are pruned automatically each day so the map only shows what is ahead.</p>
				<p>If you know a conference that is missing from the map, or if you spot a date or location that has changed, send it over.</p>
				<div class="oss-actions">
					<a class="btn btn-primary" href="/submit/">+ Submit Event</a>
					<a class="btn" href="/contact/">Contact Me</a>
				</div>
			</section>
		</div>

		<section class="sources-section">
			<div class="sources-head">
				<div>
					<h2>Data &amp; Accuracy ({sourceCount} active sources)</h2>
					<p class="sub">Event dates and details are compiled from public event listing sources and verified against official event sites. Dates can shift year to year, so always confirm on the official site before booking travel.</p>
				</div>
			</div>
			<div class="sources-grid">
				{sources.map((s) => (
					<div class="source-card card">
						<div class="source-name">
							{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.name} &rarr;</a> : <strong>{s.name}</strong>}
						</div>
						<p class="source-desc">{s.desc}</p>
					</div>
				))}
			</div>
		</section>
	</main>
</Layout>

<style>
	.about-hero {
		max-width: 780px;
		margin-bottom: 28px;
	}
	h1 {
		margin: 0 0 10px;
		font-size: 34px;
		font-weight: 700;
		line-height: 1.15;
	}
	.lead {
		margin: 0;
		font-size: 18px;
		line-height: 1.6;
		color: var(--text);
	}
	.about-top-grid {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 20px;
		margin-bottom: 36px;
	}
	.sec-kicker {
		display: block;
		font-family: var(--font);
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		margin-bottom: 4px;
	}
	h2 {
		margin: 0 0 12px;
		font-size: 22px;
		font-weight: 700;
	}
	p {
		color: var(--text);
		font-size: 16.5px;
		line-height: 1.6;
		margin: 0 0 12px;
	}
	a {
		color: var(--accent);
	}
	.builder-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 24px;
	}
	.builder-text {
		flex: 1;
		min-width: 0;
	}
	.builder-text p:last-child {
		margin-bottom: 0;
	}
	.builder-pin {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 10px;
		flex-shrink: 0;
		padding-top: 8px;
	}
	.pin-shape {
		display: block;
		width: 76px;
		height: 76px;
		border-radius: 50% 50% 50% 0;
		transform: rotate(-45deg);
		overflow: hidden;
		border: 3px solid var(--text);
		/* rotated corner pokes ~16px below the box, keep it clear of the name */
		margin-bottom: 18px;
	}
	.pin-shape img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: rotate(45deg) scale(1.4);
	}
	.pin-name {
		margin: 0;
		font-size: 14.5px;
		line-height: 1.35;
	}
	.pin-role {
		font-family: var(--font);
		font-size: 12px;
		color: var(--text-dim);
		text-transform: uppercase;
	}
	.oss-card {
		display: flex;
		flex-direction: column;
	}
	.oss-actions {
		margin-top: auto;
		padding-top: 12px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.sources-head {
		margin-bottom: 16px;
	}
	.sources-head .sub {
		color: var(--text-dim);
		max-width: 760px;
		margin: 0;
	}
	.sources-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 12px;
	}
	.source-card {
		padding: 14px 16px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.source-name a,
	.source-name strong {
		font-size: 16.5px;
		font-weight: 700;
		text-decoration: none;
		color: var(--text);
	}
	.source-name a:hover {
		color: var(--accent);
	}
	.source-desc {
		margin: 0;
		font-size: 14.5px;
		color: var(--text-dim);
		line-height: 1.45;
	}
	@media (max-width: 860px) {
		.about-top-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 520px) {
		.builder-row {
			flex-direction: column-reverse;
			align-items: flex-start;
		}
	}
</style>
