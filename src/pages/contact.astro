---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const TURNSTILE_SITEKEY = "0x4AAAAAAEwHeenj5gz4VHU9";
---
<Layout title="Contact | Tech Events Map" description="Get in touch with Tech Events Map: event suggestions, corrections, or press." breadcrumbs={[{ name: "Home", path: "/" }, { name: "Contact", path: "/contact/" }]}>
	<SiteHeader />
	<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
	<main class="wrap-wide">
		<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>Contact</nav>
		<div class="page-head">
			<h1>Contact</h1>
			<p class="sub">For event corrections, questions, or press enquiries, use the form below. I read every message.</p>
		</div>

		<div class="contact-split">
			<form id="contact-form" class="card form-card">
				<input type="text" name="company" tabindex="-1" autocomplete="off" class="hp-field" />

				<label>Name *<input type="text" name="name" required maxlength="120" placeholder="Your name" /></label>
				<label>Email *<input type="email" name="email" required maxlength="200" placeholder="you@example.com" /></label>
				<label>Message *<textarea name="message" required maxlength="2000" rows="6" placeholder="How can I help?"></textarea></label>

				<div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>

				<div class="submit-row">
					<button type="submit" class="btn btn-primary">Send message</button>
					<p id="contact-result" role="status"></p>
				</div>
			</form>

			<aside class="info-col">
				<div class="card info-card">
					<span class="kicker">Direct Email</span>
					<h2>Other Ways to Reach Me</h2>
					<p>Prefer email? Write directly to <a href="mailto:contact@techeventsmap.com">contact@techeventsmap.com</a>.</p>
				</div>

				<div class="card info-card">
					<span class="kicker">Adding a Conference</span>
					<h2>Missing an Event?</h2>
					<p>If you want to add a new tech, startup, AI, or fintech conference to the map, use the dedicated submission form for automated verification.</p>
					<a class="btn" href="/submit/">+ Submit an Event &rarr;</a>
				</div>
			</aside>
		</div>
	</main>
</Layout>

<style>
	.page-head {
		margin-bottom: 24px;
	}
	h1 {
		margin: 0 0 6px;
		font-size: 32px;
		font-weight: 700;
		line-height: 1.15;
	}
	.sub {
		color: var(--text-dim);
		font-size: 16.5px;
		margin: 0;
	}
	.contact-split {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
		gap: 28px;
		align-items: start;
	}
	.form-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	form label {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: var(--font);
		font-size: 12px;
		font-weight: 700;
		color: var(--text-dim);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	form input[type="text"], form input[type="email"], form textarea {
		padding: 9px 12px;
		font-family: var(--font);
		font-size: 16px;
		font-weight: 400;
		text-transform: none;
		letter-spacing: normal;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 5px;
		outline: none;
	}
	form input:focus, form textarea:focus {
		border-color: var(--accent);
	}
	form textarea {
		resize: vertical;
	}
	.hp-field {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.submit-row {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}
	form button:disabled {
		opacity: 0.6;
		cursor: default;
	}
	#contact-result {
		font-size: 14.5px;
		margin: 0;
		font-family: var(--font);
	}
	.info-col {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.kicker {
		display: block;
		font-family: var(--font);
		font-size: 11.5px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		margin-bottom: 4px;
	}
	.info-card h2 {
		margin: 0 0 10px;
		font-size: 19px;
	}
	.info-card p {
		margin: 0 0 12px;
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--text-dim);
	}
	.info-card p:last-child {
		margin-bottom: 0;
	}
	.info-card a:not(.btn) {
		color: var(--accent);
	}
	@media (max-width: 820px) {
		.contact-split {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement;
	const resultEl = document.getElementById("contact-result") as HTMLParagraphElement;
	const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement;

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		resultEl.textContent = "Sending...";
		submitBtn.disabled = true;

		const fd = new FormData(form);
		if (String(fd.get("company") || "").trim() !== "") {
			resultEl.textContent = "";
			submitBtn.disabled = false;
			return;
		}

		const payload = {
			company: fd.get("company"),
			name: fd.get("name"),
			email: fd.get("email"),
			message: fd.get("message"),
			turnstileToken: fd.get("cf-turnstile-response"),
		};

		try {
			const res = await fetch("/api/contact", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const data = await res.json();
			resultEl.textContent = data.message || data.error || "Something went wrong.";
			if (data.ok) form.reset();
		} catch {
			resultEl.textContent = "Network error, please try again.";
		} finally {
			submitBtn.disabled = false;
		}
	});
</script>
