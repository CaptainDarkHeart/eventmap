---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const TURNSTILE_SITEKEY = "0x4AAAAAAEwHeenj5gz4VHU9";
---
<Layout title="Contact — Tech Events Map" description="Get in touch with Tech Events Map: event suggestions, corrections, or press.">
	<SiteHeader />
	<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
	<div class="wrap">
		<h1>Contact</h1>
		<p>Event suggestions, corrections, or press enquiries, use the form below. I read every message.</p>

		<form id="contact-form">
			<input type="text" name="company" tabindex="-1" autocomplete="off" class="hp-field" />

			<label>Name *<input type="text" name="name" required maxlength="120" /></label>
			<label>Email *<input type="email" name="email" required maxlength="200" /></label>
			<label>Message *<textarea name="message" required maxlength="2000" rows="6"></textarea></label>

			<div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>

			<button type="submit">Send message</button>
			<p id="contact-result" role="status"></p>
		</form>

		<p class="alt">Prefer email? <a href="mailto:hello@techeventsmap.com">hello@techeventsmap.com</a></p>
	</div>
</Layout>

<style>
	.wrap { max-width: 640px; margin: 0 auto; padding: 24px 16px 60px; }
	h1 { margin: 14px 0 16px; font-size: 32.5px; font-weight: 700; }
	p { color: var(--text); font-size: 17.5px; line-height: 1.6; margin: 0 0 10px; }
	a { color: var(--accent); }
	form { display: flex; flex-direction: column; gap: 16px; max-width: 480px; margin: 24px 0; }
	form label { display: flex; flex-direction: column; gap: 6px; font-family: var(--font); font-size: 15px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.04em; }
	form input[type="text"], form input[type="email"], form textarea {
		padding: 10px 12px;
		font: inherit;
		font-size: 17px;
		text-transform: none;
		letter-spacing: normal;
		color: var(--text);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
	}
	form textarea { resize: vertical; }
	.hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
	form button {
		align-self: flex-start;
		padding: 10px 22px;
		font-family: var(--font);
		font-size: 15.5px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--bg);
		background: var(--accent);
		border: none;
		border-radius: 6px;
		cursor: pointer;
	}
	form button:disabled { opacity: 0.6; cursor: default; }
	#contact-result { font-size: 15.5px; margin-top: 4px; }
	.alt { font-size: 16px; color: var(--text-dim); }
</style>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement;
	const resultEl = document.getElementById("contact-result") as HTMLParagraphElement;
	const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement;

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		resultEl.textContent = "Sending...";
		submitBtn.disabled = true;

		const fd = new FormData(form);
		if (String(fd.get("company") || "").trim() !== "") return;

		const payload = {
			company: fd.get("company"),
			name: fd.get("name"),
			email: fd.get("email"),
			message: fd.get("message"),
			turnstileToken: fd.get("cf-turnstile-response"),
		};

		try {
			const res = await fetch("/api/contact", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const data = await res.json();
			resultEl.textContent = data.message || data.error || "Something went wrong.";
			if (data.ok) form.reset();
		} catch {
			resultEl.textContent = "Network error, please try again.";
		} finally {
			submitBtn.disabled = false;
		}
	});
</script>
