---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---
<Layout title="Page not found — Tech Events Map" description="This page doesn't exist.">
	<SiteHeader />
	<div class="bg-video">
		<iframe
			src="https://www.youtube-nocookie.com/embed/ihyjXd2C-E8?start=55&autoplay=1&mute=1&loop=1&playlist=ihyjXd2C-E8&controls=0&modestbranding=1&rel=0&playsinline=1"
			title="Background video"
			frameborder="0"
			allow="autoplay; encrypted-media"
			allowfullscreen
		></iframe>
	</div>
	<div class="overlay"></div>
	<div class="wrap">
		<h1>This is not the page you're looking for</h1>
		<p class="links">
			<a href="/">Back to the map</a>
			<a href="/events">Browse all events</a>
		</p>
	</div>
</Layout>

<style>
	.bg-video {
		position: fixed;
		inset: 0;
		overflow: hidden;
		z-index: 0;
		pointer-events: none;
	}
	.bg-video iframe {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 177.77vh;
		min-width: 100vw;
		height: 56.25vw;
		min-height: 100vh;
		transform: translate(-50%, -50%);
	}
	.overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
		z-index: 0;
	}
	.wrap {
		position: relative;
		z-index: 1;
		max-width: 640px;
		margin: 0 auto;
		padding: 160px 16px 60px;
		text-align: center;
		min-height: 100vh;
		box-sizing: border-box;
	}
	h1 { margin: 0 0 20px; font-size: 32px; font-weight: 700; color: #fff; line-height: 1.3; }
	.links { display: flex; gap: 20px; justify-content: center; margin-top: 20px; }
	a { color: #fff; font-weight: 700; text-decoration: underline; }
	a:hover { opacity: 0.8; }
</style>
