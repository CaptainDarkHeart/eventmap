---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---
<Layout title="Page not found — Tech Events Map" description="This page doesn't exist.">
	<SiteHeader />
	<div class="bg-video">
		<iframe
			src="https://www.youtube-nocookie.com/embed/ihyjXd2C-E8?start=55&autoplay=1&mute=1&loop=1&playlist=ihyjXd2C-E8&controls=0&modestbranding=1&rel=0&playsinline=1&disablekb=1&iv_load_policy=3"
			title="Background video"
			frameborder="0"
			allow="autoplay; encrypted-media"
			allowfullscreen
		></iframe>
	</div>
	<div class="overlay"></div>
	<div class="wrap">
		<h1>This is not the page you're looking for</h1>
		<p class="links">
			<a href="/">Back to the map</a>
			<a href="/events">Browse all events</a>
		</p>
	</div>
</Layout>

<style>
	@font-face {
		font-family: 'Star Jedi';
		font-style: normal;
		font-weight: 400;
		src: url('/fonts/Starjedi.ttf') format('truetype');
	}
	.bg-video {
		position: fixed;
		inset: 0;
		overflow: hidden;
		z-index: 0;
		pointer-events: none;
	}
	.bg-video iframe {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 177.77vh;
		min-width: 100vw;
		height: 56.25vw;
		min-height: 100vh;
		transform: translate(-50%, -50%) scale(1.4);
	}
	.overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
		z-index: 0;
	}
	.wrap {
		position: relative;
		z-index: 1;
		max-width: 640px;
		margin: 0 auto;
		padding: 16px;
		text-align: center;
		min-height: 100vh;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	h1 {
		margin: 0 0 24px;
		font-family: 'Star Jedi', sans-serif;
		font-size: 30px;
		font-weight: 400;
		letter-spacing: 2px;
		color: #ffe81f;
		text-shadow: 0 0 12px rgba(255, 232, 31, 0.6);
		line-height: 1.5;
	}
	.links { display: flex; gap: 20px; justify-content: center; margin-top: 20px; }
	a { color: #fff; font-weight: 700; text-decoration: underline; }
	a:hover { opacity: 0.8; }
</style>
