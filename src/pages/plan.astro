---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { TOPICS } from "../lib/topics";
import events from "../data/events.json";

// Only what the planner and the ICS export need, keeps the inlined JSON small.
const slim = events.map((e) => ({
	id: e.id,
	slug: e.slug,
	name: e.name,
	city: e.city,
	country: e.country,
	lat: e.lat,
	lng: e.lng,
	start: e.start,
	end: e.end,
	tier: e.tier,
	topics: e.topics,
	url: e.url ?? "",
}));
const cities = [...new Set(events.map((e) => e.city))].sort((a, b) => a.localeCompare(b));
---
<Layout
	title="Plan your event year | Tech Events Map"
	description="Tell me your topics, goal and travel budget. Get a ranked itinerary of tech and startup conferences, ready for your calendar."
	breadcrumbs={[{ name: "Home", path: "/" }, { name: "Plan", path: "/plan/" }]}
>
	<SiteHeader />
	<main class="wrap-wide">
		<div class="page-head">
			<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>Trip Planner</nav>
			<h1>Plan your event year</h1>
			<p class="sub">Pick your topics, goal and travel budget. I rank every upcoming event and suggest a trip plan. Runs in your browser, nothing is stored on a server.</p>
		</div>

		<div class="planner-split">
			<aside class="planner-sidebar">
				<form id="plan-form" class="form card" autocomplete="off" onsubmit="return false">
					<div class="form-head">
						<h2>Your Profile</h2>
						<span class="form-badge">Auto-saved locally</span>
					</div>

					<div class="field wide">
						<label for="home">Home city</label>
						<input id="home" class="input" type="text" list="city-list" placeholder="e.g. London" />
						<datalist id="city-list">
							{cities.map((c) => <option value={c} />)}
						</datalist>
						<p id="home-note" class="hint" hidden>Not one of my event cities, so distance is ignored.</p>
					</div>

					<div class="field wide">
						<label for="goal">Main goal</label>
						<select id="goal" class="input">
							<option value="network">Network</option>
							<option value="learn">Learn</option>
							<option value="sell">Sell</option>
							<option value="raise">Raise funding</option>
							<option value="press">Press and PR</option>
						</select>
					</div>

					<div class="field wide">
						<span class="label">Topics</span>
						<div class="filter-tags" id="topic-tags">
							{Object.entries(TOPICS).map(([key, t]) => (
								<button type="button" class="filter-tag" data-topic={key} aria-pressed="false">
									<span class="dot" style={`background:${t.color}`}></span>{t.label}
								</button>
							))}
						</div>
						<p class="hint">Leave empty for no topic preference.</p>
					</div>

					<div class="field">
						<label for="from">From</label>
						<input id="from" class="input" type="date" />
					</div>
					<div class="field">
						<label for="to">To</label>
						<input id="to" class="input" type="date" />
					</div>

					<div class="field">
						<label for="maxTrips">Trips</label>
						<select id="maxTrips" class="input">
							{[1, 2, 3, 4, 5, 6, 8, 10, 12].map((n) => <option value={n} selected={n === 4}>Up to {n}</option>)}
						</select>
					</div>
					<div class="field">
						<label for="maxDays">Days away</label>
						<select id="maxDays" class="input">
							{[5, 10, 15, 20, 30, 45, 60, 90].map((n) => <option value={n} selected={n === 20}>Up to {n}</option>)}
						</select>
					</div>

					<div class="field">
						<label for="maxKm">Distance</label>
						<select id="maxKm" class="input">
							<option value="500">Up to 500 km</option>
							<option value="1500">Up to 1,500 km</option>
							<option value="5000">Up to 5,000 km</option>
							<option value="0" selected>Anywhere</option>
						</select>
					</div>
					<div class="field">
						<label for="tierFloor">Event size</label>
						<select id="tierFloor" class="input">
							<option value="notable" selected>Any size</option>
							<option value="major">Major &amp; mega</option>
							<option value="mega">Mega only</option>
						</select>
					</div>

					<p class="note">Scores use topic fit, event size, distance and lead time. Event size is the only networking signal for now: I do not have attendee lists.</p>
				</form>
			</aside>

			<section class="planner-results" aria-label="Recommended itinerary">
				<div class="results-bar card">
					<div id="summary" class="summary" aria-live="polite"></div>
					<div class="actions">
						<button id="ics-btn" type="button" class="btn btn-primary">Download .ics</button>
						<button id="share-btn" type="button" class="btn">Copy share link</button>
						<span id="share-status" class="hint" role="status"></span>
					</div>
				</div>

				<p id="empty" class="empty card" hidden>No events match. Widen the dates, distance or size.</p>
				<div id="trips" class="trips-list"></div>

				<div id="alt-wrap" class="alt-wrap" hidden>
					<div class="alt-head">
						<h2>Also consider</h2>
						<p class="hint">High-scoring conferences that did not fit your trip or day limits.</p>
					</div>
					<div id="alts" class="alts-grid"></div>
				</div>
			</section>
		</div>
	</main>

	<script is:inline type="application/json" id="events-data" set:html={JSON.stringify(slim)} />
</Layout>

<script>
	import { plan, addDays } from "../lib/planner.js";
	import { buildCalendar } from "../lib/ics";

	type Ev = {
		id: number;
		slug: string;
		name: string;
		city: string;
		country: string;
		lat: number;
		lng: number;
		start: string;
		end: string;
		tier: string;
		topics: string[];
		url: string;
	};
	type Scored = { ev: Ev; score: number; reasons: string[] };
	type Trip = { start: string; end: string; days: number; score: number; events: Scored[] };
	type FormState = {
		home: string;
		goal: string;
		topics: string[];
		from: string;
		to: string;
		maxTrips: number;
		maxDays: number;
		maxKm: number;
		tierFloor: string;
	};

	const STORAGE_KEY = "em_plan_profile";
	const events: Ev[] = JSON.parse(document.getElementById("events-data")!.textContent ?? "[]");
	const today = new Date().toISOString().slice(0, 10);

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const home = $<HTMLInputElement>("home");
	const homeNote = $("home-note");
	const goal = $<HTMLSelectElement>("goal");
	const from = $<HTMLInputElement>("from");
	const to = $<HTMLInputElement>("to");
	const maxTrips = $<HTMLSelectElement>("maxTrips");
	const maxDays = $<HTMLSelectElement>("maxDays");
	const maxKm = $<HTMLSelectElement>("maxKm");
	const tierFloor = $<HTMLSelectElement>("tierFloor");
	const topicTags = $("topic-tags");
	const tripsEl = $("trips");
	const altsEl = $("alts");
	const altWrap = $("alt-wrap");
	const emptyEl = $("empty");
	const summaryEl = $("summary");
	const shareStatus = $("share-status");

	// city name (lowercase) -> first known coordinates
	const cityCoords = new Map<string, { lat: number; lng: number; label: string }>();
	for (const e of events) {
		const key = e.city.toLowerCase();
		if (!cityCoords.has(key)) cityCoords.set(key, { lat: e.lat, lng: e.lng, label: e.city });
	}

	function readForm(): FormState {
		return {
			home: home.value.trim(),
			goal: goal.value,
			topics: Array.from(topicTags.querySelectorAll<HTMLButtonElement>("[aria-pressed='true']")).map(
				(b) => b.dataset.topic ?? "",
			),
			from: from.value,
			to: to.value,
			maxTrips: Number(maxTrips.value),
			maxDays: Number(maxDays.value),
			maxKm: Number(maxKm.value),
			tierFloor: tierFloor.value,
		};
	}

	function writeForm(s: Partial<FormState>) {
		home.value = s.home ?? "";
		goal.value = s.goal ?? "network";
		from.value = s.from || today;
		to.value = s.to || addDays(today, 183);
		maxTrips.value = String(s.maxTrips ?? 4);
		maxDays.value = String(s.maxDays ?? 20);
		maxKm.value = String(s.maxKm ?? 0);
		tierFloor.value = s.tierFloor ?? "notable";
		const picked = new Set(s.topics ?? []);
		topicTags.querySelectorAll<HTMLButtonElement>(".filter-tag").forEach((b) => {
			const on = picked.has(b.dataset.topic ?? "");
			b.classList.toggle("active", on);
			b.setAttribute("aria-pressed", on ? "true" : "false");
		});
	}

	function loadInitial(): Partial<FormState> {
		try {
			const m = location.hash.match(/^#p=(.+)$/);
			if (m) return JSON.parse(decodeURIComponent(m[1]));
		} catch {
			// malformed share link: fall through to saved profile
		}
		try {
			const saved = localStorage.getItem(STORAGE_KEY);
			if (saved) return JSON.parse(saved);
		} catch {
			// storage blocked or corrupt: use defaults
		}
		return {};
	}

	function fmtRange(start: string, end: string) {
		const s = new Date(start + "T00:00:00Z");
		const e = new Date(end + "T00:00:00Z");
		const opt: Intl.DateTimeFormatOptions = { day: "numeric", month: "short", timeZone: "UTC" };
		const sStr = s.toLocaleDateString("en-GB", opt);
		if (start === end) return `${sStr} ${s.getUTCFullYear()}`;
		return `${sStr} - ${e.toLocaleDateString("en-GB", { ...opt, year: "numeric" })}`;
	}

	function gcalUrl(ev: Ev) {
		const ymd = (d: string) => d.replace(/-/g, "");
		const params = new URLSearchParams({
			action: "TEMPLATE",
			text: ev.name,
			dates: `${ymd(ev.start)}/${ymd(addDays(ev.end, 1))}`,
			details: ev.url || `https://techeventsmap.com/events/${ev.slug}/`,
			location: `${ev.city}, ${ev.country}`,
		});
		return `https://calendar.google.com/calendar/render?${params.toString()}`;
	}

	function el(tag: string, cls?: string, text?: string) {
		const node = document.createElement(tag);
		if (cls) node.className = cls;
		if (text !== undefined) node.textContent = text;
		return node;
	}

	function eventRow(s: Scored) {
		const row = el("div", "ev");
		const head = el("div", "ev-head");
		const link = el("a", "ev-name", s.ev.name) as HTMLAnchorElement;
		link.href = `/events/${s.ev.slug}/`;
		head.append(link, el("span", `ev-score tier-${s.ev.tier}`, `Score ${s.score}`));
		const meta = el("div", "ev-meta", `${fmtRange(s.ev.start, s.ev.end)} · ${s.ev.city}, ${s.ev.country}`);
		const bottom = el("div", "ev-bottom");
		const chips = el("div", "chips");
		for (const r of s.reasons) chips.append(el("span", "chip", r));
		const cal = el("a", "cal-link", "+ Google Calendar") as HTMLAnchorElement;
		cal.href = gcalUrl(s.ev);
		cal.target = "_blank";
		cal.rel = "noopener";
		bottom.append(chips, cal);
		row.append(head, meta, bottom);
		return row;
	}

	let current: Trip[] = [];

	function render() {
		const form = readForm();
		const coords = cityCoords.get(form.home.toLowerCase());
		homeNote.hidden = !form.home || !!coords;

		const result = plan(
			events,
			{
				homeCity: coords?.label ?? form.home,
				homeLat: coords?.lat,
				homeLng: coords?.lng,
				topics: form.topics,
				goal: form.goal,
				from: form.from,
				to: form.to,
				maxTrips: form.maxTrips,
				maxDays: form.maxDays,
				maxKm: form.maxKm,
				tierFloor: form.tierFloor,
			},
			today,
		) as { trips: Trip[]; alternates: Scored[]; daysUsed: number; scored: Scored[] };

		current = result.trips;
		tripsEl.replaceChildren();
		altsEl.replaceChildren();

		emptyEl.hidden = result.scored.length > 0;
		if (result.trips.length > 0) {
			summaryEl.innerHTML = `
				<div class="stat-pill"><strong>${result.trips.length}</strong> trip${result.trips.length === 1 ? "" : "s"}</div>
				<div class="stat-pill"><strong>${result.daysUsed}</strong> day${result.daysUsed === 1 ? "" : "s"} away</div>
				<div class="stat-pill"><strong>${result.scored.length}</strong> matching events</div>
			`;
		} else {
			summaryEl.textContent = "0 matching trips";
		}

		result.trips.forEach((trip, i) => {
			const card = el("section", "trip card");
			const h = el("div", "trip-head");
			const titleWrap = el("div", "trip-title-wrap");
			titleWrap.append(
				el("span", "trip-num", `Trip ${i + 1}`),
				el("h2", "trip-city", `${trip.events[0].ev.city}, ${trip.events[0].ev.country}`),
			);
			h.append(
				titleWrap,
				el("span", "trip-dates", `${fmtRange(trip.start, trip.end)} · ${trip.days} day${trip.days === 1 ? "" : "s"}`),
			);
			card.append(h);
			trip.events.forEach((s) => card.append(eventRow(s)));
			tripsEl.append(card);
		});

		result.alternates.forEach((s) => {
			const altCard = el("div", "alt-card card");
			altCard.append(eventRow(s));
			altsEl.append(altCard);
		});
		altWrap.hidden = result.alternates.length === 0;
	}

	function persist() {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(readForm()));
		} catch {
			// private mode: plan still works, just is not remembered
		}
	}

	function onChange() {
		persist();
		render();
	}

	topicTags.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-tag");
		if (!btn) return;
		const on = btn.getAttribute("aria-pressed") !== "true";
		btn.setAttribute("aria-pressed", on ? "true" : "false");
		btn.classList.toggle("active", on);
		onChange();
	});
	[home, goal, from, to, maxTrips, maxDays, maxKm, tierFloor].forEach((c) => {
		c.addEventListener("input", onChange);
		c.addEventListener("change", onChange);
	});

	$("ics-btn").addEventListener("click", () => {
		const picked = current.flatMap((t) => t.events.map((s) => s.ev)).sort((a, b) => a.start.localeCompare(b.start));
		if (picked.length === 0) {
			shareStatus.textContent = "Nothing to export yet.";
			return;
		}
		const ics = buildCalendar(
			picked.map((e) => ({ uid: String(e.id), name: e.name, start: e.start, end: e.end, city: e.city, country: e.country, url: e.url, slug: e.slug })),
			"My Tech Events Plan",
		);
		const blob = new Blob([ics], { type: "text/calendar;charset=utf-8" });
		const url = URL.createObjectURL(blob);
		const a = document.createElement("a");
		a.href = url;
		a.download = "my-event-plan.ics";
		document.body.appendChild(a);
		a.click();
		a.remove();
		URL.revokeObjectURL(url);
		shareStatus.textContent = "";
	});

	$("share-btn").addEventListener("click", async () => {
		const link = `${location.origin}${location.pathname}#p=${encodeURIComponent(JSON.stringify(readForm()))}`;
		try {
			await navigator.clipboard.writeText(link);
			shareStatus.textContent = "Link copied.";
		} catch {
			history.replaceState(null, "", link);
			shareStatus.textContent = "Copy the address bar link.";
		}
	});

	writeForm(loadInitial());
	render();
</script>

<style is:global>
	/* Global because trip cards and chips are built by the client script, which
	   Astro's scoped styles cannot reach. */
	.page-head {
		margin-bottom: 24px;
	}
	.page-head h1 {
		margin: 0 0 6px;
		font-size: 32px;
		font-weight: 700;
		line-height: 1.15;
	}
	.page-head .sub {
		color: var(--text-dim);
		margin: 0;
		font-size: 16.5px;
		max-width: 720px;
	}
	.planner-split {
		display: grid;
		grid-template-columns: 360px minmax(0, 1fr);
		gap: 28px;
		align-items: start;
	}
	.planner-sidebar {
		position: sticky;
		top: 76px;
	}
	.form {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px 12px;
	}
	.form-head {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--border);
	}
	.form-head h2 {
		margin: 0;
		font-size: 17px;
		font-weight: 700;
	}
	.form-badge {
		font-family: var(--font);
		font-size: 11px;
		color: var(--text-dim);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}
	.field.wide {
		grid-column: 1 / -1;
	}
	label, .label {
		font-family: var(--font);
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-dim);
	}
	.input {
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font);
		font-size: 15px;
		padding: 7px 10px;
		border-radius: 4px;
		outline: none;
		width: 100%;
	}
	.input:focus {
		border-color: var(--accent);
	}
	.form .filter-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
	}
	.form .filter-tag {
		background: var(--bg);
		font-size: 13px;
		padding: 4px 9px;
	}
	.hint {
		margin: 0;
		font-size: 13px;
		color: var(--text-dim);
	}
	.note {
		grid-column: 1 / -1;
		margin: 4px 0 0;
		padding-top: 10px;
		border-top: 1px solid var(--border);
		font-size: 13px;
		color: var(--text-dim);
		line-height: 1.45;
	}
	.results-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 14px;
		padding: 14px 18px;
		margin-bottom: 18px;
	}
	.summary {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		font-size: 15px;
	}
	.stat-pill {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 5px 10px;
		font-family: var(--font);
		font-size: 13px;
	}
	.stat-pill strong {
		color: var(--accent);
		font-size: 14.5px;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.empty {
		color: var(--text-dim);
		font-family: var(--font);
		padding: 28px;
		text-align: center;
	}
	.trips-list {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.trip {
		border-left: 3px solid var(--accent);
		padding: 16px 20px;
	}
	.trip-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 10px;
		flex-wrap: wrap;
		margin-bottom: 10px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--border);
	}
	.trip-title-wrap {
		display: flex;
		align-items: baseline;
		gap: 10px;
	}
	.trip-num {
		font-family: var(--font);
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		padding: 2px 7px;
		border-radius: 3px;
	}
	.trip-city {
		margin: 0;
		font-size: 20px;
		font-weight: 700;
	}
	.trip-dates {
		font-family: var(--font);
		font-size: 13.5px;
		color: var(--text-dim);
	}
	.ev {
		padding: 12px 0;
		border-top: 1px solid var(--border);
	}
	.trip .ev:first-of-type {
		border-top: none;
		padding-top: 2px;
	}
	.trip .ev:last-of-type {
		padding-bottom: 0;
	}
	.ev-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 10px;
	}
	.ev-name {
		font-size: 17.5px;
		font-weight: 700;
		text-decoration: none;
		color: var(--text);
	}
	.ev-name:hover {
		color: var(--accent);
	}
	.ev-score {
		font-family: var(--font);
		font-size: 13px;
		font-weight: 700;
		white-space: nowrap;
	}
	.ev-meta {
		font-family: var(--font);
		font-size: 13.5px;
		color: var(--text-dim);
		margin: 3px 0 8px;
	}
	.ev-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
	}
	.chip {
		font-family: var(--font);
		font-size: 12px;
		padding: 2px 8px;
		border: 1px solid var(--border);
		background: var(--bg);
		border-radius: 999px;
		color: var(--text-dim);
	}
	.cal-link {
		color: var(--accent);
		font-family: var(--font);
		font-size: 12.5px;
		text-decoration: none;
	}
	.cal-link:hover {
		text-decoration: underline;
